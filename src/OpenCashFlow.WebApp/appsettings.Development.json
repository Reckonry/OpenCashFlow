{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Account": {
    "CookieDomain": ".localhost",
    "SessionCookieDomain": ".localhost",
    "API": "https://localhost:9001",
    "Login": "https://localhost:7001/Login",
    "FastLogin": "https://localhost:7001/FastLogin",
    "Logout": "https://localhost:7001/Logout",
    "AppUrl": "https://localhost:7001/"
  },

  "JwtSettings": {
    "SecretKey": "CHANGE_ME_WITH_A_RANDOM_64_CHAR_SECRET_FOR_SELF_HOSTED_SETUP",
    "Issuer": "https://localhost:9001",
    "Audience": [
      "https://localhost:3001",
      "https://localhost:7001"
    ]
  },

  "Sentry": {
    "Dsn": "https://YOUR_DSN_HERE",
    "TracesSampleRate": 1.0,
    "Environment": "Development",
    "Debug": true
  }
}
