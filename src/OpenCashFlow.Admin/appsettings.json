{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_WITH_A_RANDOM_64_CHAR_SECRET_FOR_SELF_HOSTED_SETUP",
    "Issuer": "https://api.opencashflow.local",
    "Audience": "https://app.opencashflow.local"
  },

  "Account": {
    "CookieDomain": ".opencashflow.local",
    "SessionCookieDomain": ".opencashflow.local",
    "API": "https://api.opencashflow.local",
    "Login": "https://app.opencashflow.local/Login",
    "Logout": "https://app.opencashflow.local/Account/Logout",
    "AppUrl": "https://app.opencashflow.local/",
    "ManagementUrl": "https://management.opencashflow.local/"
  },

  "Features": {
    "Billing": false
  }
}
