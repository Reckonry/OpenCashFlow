<!-- Users List Table  border-bottom -->

<div class="d-none d-xl-block">
	<div class="card">

		<div class="card-header header-elements" id="cardHeader">
			<div id="divTitle">
				<h5 class="m-0 me-2">@Localizer["Employees list"]</h5>
				<p class="">
					@Localizer["TitleDescription"]
				</p>
			</div>

			<div class="card-title-elements ms-auto">

				<button class="btn btn-primary waves-effect waves-light" type="button" aria-label="@SharedLocalizer["Search"]" title="@SharedLocalizer["Search"]">
					<i class="menu-icon tf-icons ri-search-line" aria-hidden="true"></i>
				</button>
				@{

					<a class="btn btn-success waves-effect waves-light @((employeeCount <= maxEmployees) ? "" : " disabled " )"
					   href="@((employeeCount <= maxEmployees) ? Url.Content("~/Employees/New") : "" )"
					   data-bs-toggle="tooltip" data-bs-placement="bottom" @((employeeCount <= maxEmployees) ? "" : " data-bs-original-title=\"" + @Localizer["Maximum user reached"].Value + "\"")>
						<i class="menu-icon tf-icons ri-user-add-line me-2"></i>
						@Localizer["New Employee"]
					</a>

				}
			</div>
		</div>



		<div class="table-responsive">
			<table class="table table-hover">
				<thead class="table-light">
					<tr>
						<th>@Localizer["User"]</th>
						<th>@Localizer["Role"]</th>
						<th>@Localizer["Email"]</th>
						<th>@Localizer["Last login"]</th>
						<th>@Localizer["Status"]</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@{
						if (Model != null)
							foreach (Employee_List_DTO item in Model)
							{
								<tr class="odd">
									<td>
										<div class="d-flex justify-content-start align-items-center user-name">
											<div class="avatar-wrapper">
												<a href="~/Employees/View/@item?.UserID">
													<div class="avatar avatar-sm me-3">
														@if (string.IsNullOrEmpty(item.UserAvatar))
														{
															var avatar = AvatarGenerator.GetAvatar(item?.UserLastName ?? "");
															<span class="avatar-initial rounded-circle" style="background-color:@avatar.BgColor; color:@avatar.TextColor">
																@item?.UserLastName?[0]@item?.UserFirstName[0]
															</span>
														}
														else
														{
															<img src="@Url.Content(item.UserAvatar)" alt="@Localizer["AvatarAlt"]" class="rounded-circle">
														}
													</div>
												</a>
											</div>
											<div class="d-flex flex-column">
												<a href="~/Employees/View/@item?.UserID" class="text-body text-truncate">
													<span class="fw-semibold">@Html.Raw(item?.EmployeeSurnameName?.Trim())</span>
												</a>
												<small class="text-muted"> </small>
											</div>
										</div>
									</td>
									<td>
										@{
											var roles = item?.Roles;
											if (roles != null && roles.Count > 0)
											{
												foreach (var role in roles)
												{
													if (role == null || string.IsNullOrWhiteSpace(role.RoleName))
													{
														continue;
													}
													<span class="badge bg-label-info me-1">@Localizer["Role_" + role.RoleName]</span>
												}
											}
											else
											{
												<span>-/-</span>
											}
										}
									</td>
									<td>
										@(string.IsNullOrEmpty(item?.Email) ? "-/-" : @Html.Raw("<p class=\"p-0 m-0\"><i class=\"fa-regular fa-envelope me-2\"></i>" + @item.Email + "</p>"))
									</td>
									<td>

									</td>
									<td>
										@{
											if (item?.IsApproved ?? false)
											{
												<span class="badge bg-label-success" text-capitalized="">@Localizer["Active"]</span>
											}
											else
											{
												<span class="badge bg-label-warning" text-capitalized="">@Localizer["Not Approved"]</span>
											}
										}
									</td>
									<td>
										<div>
											@if (User.Claims.Any(c => c.Type == ClaimTypes.Role && c.Value == "Administrator"))
											{
												<a href="~/Employees/Edit/@item!.UserID" class="" title="Edit employee">
													<i class='menu-icon tf-icons ri-pencil-line me-1'></i>
												</a>
												<a href="javascript:void(0)" onclick="deleteEmployee('@item!.UserID', '@Html.Raw(item?.EmployeeSurnameName?.Trim())')" class="text-danger" title="Delete employee">
													<i class='menu-icon tf-icons ri-delete-bin-line me-1'></i>
												</a>
											}
											<a href="~/Employees/View/@item!.UserID" class="" title="View employee">
												<i class='menu-icon tf-icons ri-eye-line me-1'></i>
											</a>
										</div>
									</td>
								</tr>
							}
					}
				</tbody>
			</table>








