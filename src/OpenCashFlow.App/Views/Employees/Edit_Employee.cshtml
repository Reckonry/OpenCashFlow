@using Shared.DTOs.Employees
@model Employee_Detail_DTO
@{
    ViewData["Title"] = Localizer["EditEmployeeTitle"].Value;
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/quill/typography.css">
    <link rel="stylesheet" href="~/vendor/libs/quill/katex.css">
    <link rel="stylesheet" href="~/vendor/libs/quill/editor.css">
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css">
    <link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.css">
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css">
}

@section VendorScripts {
    <script src="~/vendor/libs/quill/katex.js"></script>
    <script src="~/vendor/libs/quill/quill.js"></script>
    <script src="~/vendor/libs/select2/select2.js"></script>
    <script src="~/vendor/libs/dropzone/dropzone.js"></script>
    <script src="~/vendor/libs/jquery-repeater/jquery-repeater.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/it.js"></script>
}

@section PageScripts {
    <script src="~/js/app-ecommerce-product-add.js"></script>

    <script>
        $(document).on('submit', '#createEmployeeForm', function (e) {
            // 1. Reset errors
            $('.text-danger').text('');
            $('.is-invalid').removeClass('is-invalid');

            let isValid = true;

            // Required fields
            const requiredFields = [
                { id: '#UserName', name: 'UserName', message: '@Localizer["Insert a username"]' },
                { id: '#UserFirstName', name: 'UserFirstName', message: '@Localizer["Insert a first name"]' },
                { id: '#UserLastName', name: 'UserLastName', message: '@Localizer["Insert a last name"]' },
                { id: '#Email', name: 'Email', message: '@Localizer["Insert a valid e-mail"]' },
            ];

            requiredFields.forEach(f => {
                const value = $(f.id).val()?.trim();
                if (!value || value === '00000000-0000-0000-0000-000000000000') {
                    isValid = false;
                    $(f.id).addClass('is-invalid');
                    $(`span[data-valmsg-for='${f.name}']`).text(f.message);
                }
            });

            // const emailVal = $('#Email').val()?.trim();
            // const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            // if (emailVal && !emailRegex.test(emailVal)) {
            // 	isValid = false;
            // 	$('#Email').addClass('is-invalid');
            // 	$("span[data-valmsg-for='Email']").text('@Localizer["The email you wrote is invalid"]');
            // }

        var ddlGender = $('#Gender');
        ddlGender.on("change", function () {
            if ($('#Gender option:selected').val() != '@Model.Gender') {
                $('#span_Gender').text($('#Gender option:selected').text()); $('#span_Gender_prev').addClass("valueChanged");
            } else {
                $('#span_Gender').text(""); $('#span_Gender_prev').removeClass("valueChanged");
            }
        });
        var ddlTimeZoneID = $('#Timezone');
        ddlTimeZoneID.on("change", function () {
            if ($('#Timezone option:selected').val() != '@Model.Timezone') {
                $('#span_Timezone').text($('#Timezone option:selected').text()); $('#span_Timezone_prev').addClass("valueChanged");
            } else {
                $('#span_Timezone').text(""); $('#span_Timezone_prev').removeClass("valueChanged");
            }
        });
        var ddlLanguage = $('#Language');
        ddlLanguage.on("change", function () {
            if ($('#Language option:selected').val() != '@Model.Language') {
                $('#span_Language').text($('#Language option:selected').text()); $('#span_Language_prev').addClass("valueChanged");
            } else {
                $('#span_Language').text(""); $('#span_Language_prev').removeClass("valueChanged");
            }
        });
        var ddlCountry = $('#Country');
        ddlCountry.on("change", function () {
            if ($('#Country option:selected').val() != '@Model.Country') {
                $('#span_Country').text($('#Country option:selected').text()); $('#span_Country_prev').addClass("valueChanged");
            } else {
                $('#span_Country').text(""); $('#span_Country_prev').removeClass("valueChanged");
            }
        });




            // If not valid, block submit
            if (!isValid) {
                e.preventDefault(); // <-- block only if there are errors
                return false;
            }

            // Show loader (only if valid)
            $('#SubmitButton').addClass('d-none');
            $('#Loading').removeClass('d-none');
        });
    </script>

    <script>
        // new Cleave(".date-dob", {
        // 	date: true, delimiter: "/",
        // 	datePattern: ["d", "m", "Y"]
        // });

        // new Cleave('.input-mobile', {
        // 	phone: true, phoneRegionCode: 'it', blocks: [3, 3, 3, 2]
        // });

        // new Cleave(".numeral-price", {
        // 	numeral: true,
        // 	numeralThousandsGroupStyle: 'thousand',
        // 	numeralDecimalMark: ',',
        // 	delimiter: '.'
        // });

        function resendPin(userId) {
            if (!confirm('Are you sure you want to generate and send a new PIN to this employee?')) {
                return;
            }
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Employees/Edit/ResendPin/' + userId;
            // Add CSRF token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
            document.body.appendChild(form);
            form.submit();
        }

        // Initialize date picker
        document.addEventListener('DOMContentLoaded', function() {
            const datePickerElement = document.querySelector('.date-picker');
            if (datePickerElement) {
                flatpickr(datePickerElement, {
                    dateFormat: "d/m/Y",
                    maxDate: "today", // Cannot select future dates
                    minDate: "01/01/1900", // Reasonable minimum date
                    locale: "it", // Italian locale
                    allowInput: true, // Allow manual typing
                    clickOpens: true, // Open on click
                    defaultDate: datePickerElement.value || null,
                    yearDropdown: true, // Year dropdown for faster navigation
                    monthSelectorType: "dropdown", // Month dropdown
                    prevArrow: '<i class="ri-arrow-left-s-line"></i>',
                    nextArrow: '<i class="ri-arrow-right-s-line"></i>',
                    // Year configuration - show dropdown from 1900 to today
                    onChange: function(selectedDates, dateStr, instance) {
                        // Trigger change event for validation
                        datePickerElement.dispatchEvent(new Event('change'));
                    }
                });
            }
        });

    </script>
}


@Html.Raw(ViewBag.ResponseMessage)

<div class="app-ecommerce">

    <!-- Add Product -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">

        <div class="d-flex flex-column justify-content-center">
            <h4 class="mb-1">@Localizer["Edit Employee"]</h4>
            <p class="mb-0">@Localizer["Edit employee details and information"]</p>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-4">
        </div>
    </div>

    <form method="post" id="createEmployeeForm">
        @Html.AntiForgeryToken()
        <div class="row">

            <!-- First column-->
            <div class="col-12 col-lg-8">
                <!-- Product Information -->
                <div class="card mb-6">
                    <div class="card-header">
                        <h5 class="card-tile mb-0">@Localizer["User basic"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-floating form-floating-outline mb-5">
                            <select class="form-select" name="SelectedRoleID">
                                <option value="">@Localizer["Select a role"]</option>
                                @{
                                    // Preselect first visible assigned role if present
                                    Guid preSelected = Guid.Empty;
                                    if (Model.Roles != null)
                                    {
                                        var firstVisible = Model.Roles.FirstOrDefault(r => r.IsVisible);
                                        if (firstVisible != null) preSelected = firstVisible.RoleID;
                                    }
                                    if (ViewBag.Roles is IEnumerable<Shared.DTOs.Identity.Role_List_DTO> roles)
                                    {
                                        foreach (var role in roles)
                                        {
                                            var id = role.ID;
                                            var name = role.Name;
                                            <option value="@id" selected="@(preSelected == id ? "selected" : null)">@Localizer["role_" + name]</option>
                                        }
                                    }
                                }
                            </select>
                            <label>@Localizer["Role"]</label>
                        </div>
                        <div class="row mb-5 gx-5">
                            <div class="col">
                                <div class="form-floating form-floating-outline mb-5">
                                    <input type="text" asp-for="UserName" readonly class="form-control form-lowercase" placeholder="@Localizer["Username"]" autocomplete="off" />
                                    <label>@Localizer["Username"]</label>
                                    <small><span asp-validation-for="UserName" class="text-danger"></span></small>
                                </div>
                            </div>
                            <div class="col">
                                <!-- Empty column for layout balance -->
                            </div>
                        </div>
                        <div class="row mb-5 gx-5">
                            <div class="col">
                                <div class="form-floating form-floating-outline mb-5">
                                    <input type="text" asp-for="UserFirstName" class="form-control form-lowercase" placeholder="@Localizer["Name"]" autocomplete="off" />
                                    <label>@Localizer["Name"]</label>
                                    <small><span asp-validation-for="UserFirstName" class="text-danger"></span></small>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-floating form-floating-outline mb-5">
                                    <input type="text" asp-for="UserLastName" class="form-control form-lowercase" placeholder="@Localizer["Surname"]" autocomplete="off" />
                                    <label>@Localizer["Surname"]</label>
                                    <small><span asp-validation-for="UserLastName" class="text-danger"></span></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Product Information -->
                <!-- Media -->
                <div class="card mb-6">
                    <div class="card-header">
                        <h5 class="card-tile mb-0">@Localizer["Security Info"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-5 gx-5">
                            <div class="col">
                                <div class="mb-5">
                                    <div class="input-group input-group-merge">
                                        <span class="input-group-text"><i class="ri-phone-line"></i></span>
                                        <div class="form-floating form-floating-outline">
                                            <input type="text" class="form-control" asp-for="PhoneNumber" placeholder="@Localizer["Phone number"]">
                                            <label>@Localizer["Phone number"]</label>
                                        </div>
                                    </div>
                                    <small><span asp-validation-for="PhoneNumber" class="text-danger"></span></small>
                                </div>
                            </div>
                            <div class="col">
                                <div class="mb-5">
                                    <div class="input-group input-group-merge">
                                        <span class="input-group-text"><i class="ri-mail-open-line"></i></span>
                                        <div class="form-floating form-floating-outline">
                                            <input type="text" class="form-control" asp-for="Email" placeholder="@Localizer["E-mail"]">
                                            <label>@Localizer["E-mail"]</label>
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary" onclick="resendPin('@Model.UserID')" title="Resend PIN to the email address">
                                            <i class="ri-mail-send-line"></i>
                                        </button>
                                    </div>
                                    <small><span asp-validation-for="Email" class="text-danger"></span></small>
                                    <small class="text-muted"><i class="ri-information-line"></i> A new PIN will be generated and sent when the email is updated</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /Second column -->
            <!-- Second column -->
            <div class="col-12 col-lg-4">
                <!-- Pricing Card -->
                <div class="card mb-6">
                    <div class="card-header">
                        <h5 class="card-title mb-0">@Localizer["Other Info"]</h5>
                    </div>
                    <div class="card-body">
                        <!-- Gender -->
                        <div class="form-floating form-floating-outline mb-5">
                            <select class="form-select" asp-for="Gender">
                                <option value="">@Localizer["Select gender"]</option>
                                @* @foreach (GenderTypes value in (GenderTypes[])Enum.GetValues(typeof(GenderTypes)))
                                    {
                                        <option value="@value">@Localizer["gender_" + value.ToString()]</option>
                                    } *@
                            </select>
                            <label>@Localizer["Gender"]</label>
                        </div>
                        <!-- Timezone -->
                        <div class="form-floating form-floating-outline mb-5">
                            <select class="form-select" asp-for="Timezone">
                                <option value="">@Localizer["Select a timezone"]</option>
                                @{
                                    if (ViewBag.Timezones != null)
                                    {
                                        foreach (var item in ViewBag.Timezones)
                                        {
                                            <option value="@item.Id">@item.Display</option>
                                        }
                                    }
                                }
                            </select>
                            <label>@Localizer["Timezone"]</label>
                        </div>
                        <!-- Language -->
                        <div class="form-floating form-floating-outline mb-5">
                            <select class="form-select" asp-for="Language">
                                <option value="">@Localizer["SelectALanguage"]</option>
                                @{
                                    if (ViewBag.Languages != null)
                                    {
                                        foreach (var item in ViewBag.Languages)
                                        {
                                            <option value="@item.Code">@item.Name</option>
                                        }
                                    }
                                }
                            </select>
                            <label>@Localizer["Language"]</label>
                            <small><span asp-validation-for="Language" class="text-danger"></span></small>
                        </div>
                        <!-- Country -->
                        <div class="form-floating form-floating-outline mb-5">
                            <select class="form-select" asp-for="Country">
                                <option value="">@Localizer["SelectACountry"]</option>
                                @{
                                    if (ViewBag.Countries != null)
                                    {
                                        foreach (var item in ViewBag.Countries)
                                        {
                                            <option value="@item.Code">@item.Name</option>
                                        }
                                    }
                                }
                            </select>
                            <label>@Localizer["Country"]</label>
                            <small><span asp-validation-for="Country" class="text-danger"></span></small>
                        </div>


                        <div class="divider mt-4 mb-4">
                            <div class="divider-text"><span class="text-muted">@Localizer["Employee Info"]</span></div>
                        </div>

                        <!-- Date of Birth -->
                        <div class="mb-5">
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="ri-calendar-line"></i></span>
                                <div class="form-floating form-floating-outline">
                                    <input type="text" asp-for="DoB" class="form-control date-picker" placeholder="@Localizer["Date Of Birth"]" readonly />
                                    <label>@Localizer["Date Of Birth"]</label>
                                </div>
                            </div>
                        </div>
                        <!-- Country of Birth -->
                        <div class="mb-5">
                            <div class="form-floating form-floating-outline">
                                <select class="form-select" asp-for="CoB">
                                    <option value="">@Localizer["SelectACountry"]</option>
                                    @{
                                        if (ViewBag.Countries != null)
                                        {
                                            foreach (var item in ViewBag.Countries)
                                            {
                                                <option value="@item.Code">@item.Name</option>
                                            }
                                        }
                                    }
                                </select>
                                <label>@Localizer["Country of Birth"]</label>
                            </div>
                        </div>
                        <!-- State of Birth -->
                        <div class="mb-5">
                            <div class="form-floating form-floating-outline">
                                <input type="text" asp-for="SoB" class="form-control form-capitalize" placeholder="@Localizer["State of Birth"]" />
                                <label>@Localizer["State of Birth"]</label>
                            </div>
                        </div>
                        <!-- City of Birth -->
                        <div class="mb-5">
                            <div class="form-floating form-floating-outline">
                                <input type="text" asp-for="PoB" class="form-control form-capitalize" placeholder="@Localizer["City of Birth"]" />
                                <label>@Localizer["City of Birth"]</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button id="SubmitButton" type="submit" class="btn btn-success waves-effect waves-light">
                                <i class="ri-add-large-line me-2"></i>@Localizer["Edit"]
                            </button>
                            <button class="btn btn-raised btn-success waves-effect waves-light d-none" id="Loading" type="button" disabled="">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@Localizer["Loading"]
                            </button>
                        </div>
                        <div class="d-grid gap-2 pt-3">
                            <a href="~/Employees" class="btn btn-secondary text-white">
                                <i class="ri-arrow-go-back-fill me-2"></i>@Localizer["Discard"]
                            </a>
                        </div>
                    </div>
                    <!-- /Second column -->

                </div>
    
            </div>
        </div>
    </form>
</div>
