@using Microsoft.EntityFrameworkCore.Metadata.Internal
@{
    Layout = "_BlankLayout";
    ViewData["Title"] = Localizer["ForgotPasswordTitle"].Value;
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/&#64;form-validation/popular.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
}

@section PageScripts {
    <script src="~/js/pages-auth.js"></script>
}
@* ************** Content ************** *@

<div class="position-relative">
    <div class="authentication-wrapper authentication-basic container-p-y p-4 p-sm-0">
        <div class="authentication-inner py-6">

            <!-- Logo -->
            <div class="card p-md-7 p-1">
                <!-- Forgot Password -->
                <div class="app-brand justify-content-center mt-5">
                    <a href="/" class="app-brand-link gap-2">
                        <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
                        <span class="app-brand-text demo text-heading fw-semibold">@TempData.Peek("appName")</span>
                    </a>
                </div>
                <!-- /Logo -->
                <div class="card-body mt-1">
                    <h4 class="mb-1 text-center fw-bold">@Localizer["ForgotPasswordHeading"]</h4>

                    @if (ViewBag.EmailSent == true)
                    {
                        <!-- Success message -->
                        <div class="text-center">
                            <div class="mb-4">
                                <i class="ri-mail-check-line" style="font-size: 4rem; color: #28a745;"></i>
                            </div>
                            <div class="alert alert-success text-center" role="alert">
                                <h5 class="alert-heading fw-bold mb-2">@ViewBag.SuccessTitle</h5>
                                <p class="mb-0">
                                    @ViewBag.SuccessMessage
                                </p>
                            </div>
                            <div class="mt-5">
                                <p class="text-muted mb-3">Didn't receive the email?</p>
                                <a href="/Account/ForgotPassword" class="btn btn-primary d-flex justify-content-center align-items-center btn-no-transform">
                                    <i class="ri-refresh-line me-2"></i>
                                    Send again
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Standard form -->
                        <p class="mb-5 text-center">@Localizer["ForgotPasswordSubtitle"]</p>

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                <h5 class="alert-heading fw-bold mb-2">@ViewBag.ErrorTitle ?? "Error"</h5>
                                <p class="mb-0">@ViewBag.ErrorMessage</p>
                            </div>
                        }

                        <form id="formAuthentication" class="mb-5" method="POST">
                            @Html.AntiForgeryToken()

                            <div class="form-floating form-floating-outline mb-5">
                                <input type="email" class="form-control" id="email" name="email" placeholder="@Localizer["EnterYourEmail"]" aria-label="@Localizer["Email"]" required autofocus>
                                <label>@Localizer["Email"]</label>
                            </div>
                            <button type="submit" class="btn btn-primary d-flex justify-content-center align-items-center w-100 btn-no-transform py-2">
                                <i class="ri-mail-send-line me-2"></i>
                                @Localizer["SendResetLink"]
                            </button>
                        </form>
                    }
                    <div class="text-center mt-4">
                        <a href="/" class="d-flex align-items-center justify-content-center">
                            <i class="ri-arrow-left-s-line scaleX-n1-rtl ri-20px me-1_5"></i>
                            @Localizer["BackToLogin"]
                        </a>
                    </div>
                </div>
            </div>
            <!-- /Forgot Password -->
            <img alt="@Localizer["MaskIllustrationAlt"]" src="~/img/illustrations/auth-basic-forgot-password-mask-light.png" class="authentication-image d-none d-lg-block" data-app-light-img="illustrations/auth-basic-forgot-password-mask-light.png" data-app-dark-img="illustrations/auth-basic-forgot-password-mask-dark.png" />
        </div>
    </div>
</div>
