@model IEnumerable<Company_Invoice>

@section VendorStyles {
	<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
	<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
	<link rel="stylesheet" href="~/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.css">
	<link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css">
	<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
	<!-- Row Group CSS -->
	<link rel="stylesheet" href="~/vendor/libs/datatables-rowgroup-bs5/rowgroup.bootstrap5.css">
	<!-- Form Validation -->
	<link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.css" />
}

@section VendorScripts {
	<script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
	<!-- Flat Picker -->
	<script src="~/vendor/libs/moment/moment.js"></script>
	<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
	<!-- Form Validation -->
	<script src="~/vendor/libs/&#64;form-validation/popular.js"></script>
	<script src="~/vendor/libs/&#64;form-validation/bootstrap5.js"></script>
	<script src="~/vendor/libs/&#64;form-validation/auto-focus.js"></script>
}

@section PageScripts {
	<script>
		$(document).ready(function () {
			$('#invoices-table').DataTable({
				lengthMenu: [5, 10, 25, 50, 100], // Options for number of records
				pageLength: 10, // Default number of visible records per page
				language: {
					lengthMenu: "@Localizer["Showing _MENU_ record per page"]",
					zeroRecords: "@Localizer["No element found"]",
					info: "@Localizer["Showing from _START_ to _END_ of _TOTAL_ records"]",
					infoEmpty: "@Localizer["No available record"]",
					infoFiltered: "@Localizer["(Filter from _MAX_ total records)"]",
					search: "@Localizer["Filter:"]",
					paginate: {
						previous: "@Localizer["Previous"]",
						next: "@Localizer["Next"]"
					}
				}
			});
		});
	</script>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">@Localizer["Billing History"]</h3>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped" id="invoices">
            <thead>
                <tr>
                    <th>@Localizer["#NUM"]</th>
                    <th class="text-end">@Localizer["Total"]</th>
                    <th class="text-center">@Localizer["Payment Method"]</th>
                    <th>@Localizer["Payment Date"]</th>
                    <th>@Localizer["Issued Date"]</th>
                    <th class="text-end">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model != null)
                    {
                        foreach (Company_Invoice invoice in Model)
                        {
                            <tr>
                                <td>
                                    <a class="fw-semibold" href="~/Company/Invoices/View/@invoice.InvoiceID">#@invoice.InvoiceNumber</a>
                                </td>
                                <td class="text-end">
                                    &euro; @invoice.TotalAmount
                                    <div class="text-secondary small">&euro; @invoice.TotalTaxes <span>(VAT)</span></div>
                                </td>
                                <td class="text-center">
                                    @invoice.PaymentMethod
                                    <div class="text-secondary small">via @invoice.PaymentProcessor</div>
                                </td>
                                <td>@invoice.PaymentDate?.ToShortDateString()</td>
                                <td>@invoice.IssueDate.ToShortDateString()</td>
                                <td class="text-end">
                                    <div class="btn-list justify-content-end">
                                        <a href="~/Company/Invoices/View/@invoice.InvoiceID" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="@Localizer["View"]">
                                            <i class="ri-eye-line"></i>
                                        </a>
                                        <a href="javascript:;" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="@Localizer["Download"]">
                                            <i class="ri-bill-line"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
