@using System.Globalization
@using System.Security.Claims
@model IEnumerable<Payment_List_DTO>
@functions {
    private static DateTime AsLocalFromUtcOrUnspecified(DateTime date)
    {
        // If it comes from DB as Unspecified but represents UTC, force UTC and convert to Local
        var dt = date.Kind == DateTimeKind.Unspecified
        ? DateTime.SpecifyKind(date, DateTimeKind.Utc)
        : date;
        return dt.Kind == DateTimeKind.Utc ? dt.ToLocalTime() : dt;
    }


    private string FormatDate(DateTime date)
    {
        var local = AsLocalFromUtcOrUnspecified(date);
        var culture = new CultureInfo("it-IT");
        var dayMonth = local.ToString("d MMM", culture);
        return local.Year == DateTime.Today.Year
        ? dayMonth
        : $"{dayMonth} {local:yyyy}";
    }

    private string IsoDateLocal(DateTime date)
    {
        // Ensure the attribute stores a stable, comparable local date (YYYY-MM-DD)
        var local = AsLocalFromUtcOrUnspecified(date);
        return local.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private string IsoUtc(DateTime date)
    {
        // Always normalize to UTC with "Z" suffix for the data-payment-utc attribute
        var utc = date.Kind switch
        {
            DateTimeKind.Utc => date,
            DateTimeKind.Unspecified => DateTime.SpecifyKind(date, DateTimeKind.Utc),
            _ => date.ToUniversalTime()
        };

        return utc.ToString("o", CultureInfo.InvariantCulture);
    }
}

@section PageScripts {
    <script>
        $(document).on('click', '.btn-delete-payment', function () {
            const paymentID = $(this).data('payment-id');
            if (!confirm("Are you sure you want to delete this transaction?")) return;

            $.ajax({
                url: '/internal/Payment/DeletePayment',
                method: 'POST',
                data: { paymentID: paymentID },
                success: function (resp) {
                    if (resp.success) {
                        // Do not reload the entire table: wait for SignalR
                        // If SignalR is not active, you could remove manually:
                        // $(`tr[data-payment-id="${paymentID}"]`).remove();
                    } else {
                        alert("Error: " + resp.message);
                    }
                },
                error: function () {
                    alert("Server communication error.");
                }
            });
        });

        $(document).on('click', '.btn-edit-payment', function () {
            const paymentID = $(this).data('payment-id');
            $('#modalContainer').load(`/internal/Payment/EditPaymentModal?paymentID=${paymentID}`, function () {
                const modalEl = document.getElementById('editPaymentModal');
                const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl, {
                    backdrop: 'static',
                    keyboard: false
                });
                modalInstance.show();
            });
        });
    </script>
}

<div class="table-responsive">
    <table class="table table-vcenter card-table table-striped table-hover">
        <thead>
            <tr>
                <th>Amount (&euro;)</th>
                <th>Payment</th>
                <th>Document</th>
                <th>Operator</th>
                <th class="w-1">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (Payment_List_DTO payment in Model)
                {
                    <tr data-payment-id="@payment.PaymentID" data-payment-method-id="@payment.PaymentMethodID"
                        data-document-type-id="@payment.DocumentTypeID" data-entry-type="@payment.EntryType"
                        data-date-ins="@IsoDateLocal(payment.DateIns)"
                        data-amount="@payment.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                        <td>
                            @{
                                var isIncome = string.Equals(payment.EntryType, nameof(EntryTypeEnum.Income), StringComparison.OrdinalIgnoreCase);
                                var iconClass = isIncome ? "ri-inbox-archive-line" : "ri-bank-card-line";
                                var textClass = isIncome ? "text-success" : "text-danger";
                            }

                            <div class="d-flex align-items-center">
                                <span class="avatar avatar-sm bg-secondary-lt me-3">
                                    <i class="@iconClass @textClass"></i>
                                </span>

                                <div class="flex-fill">
                                    <div class="fw-semibold">
                                        <span class="@textClass">@SharedLocalizer[payment.EntryType]</span>
                                        <span class="ms-1">€@payment.Amount.ToString("N2")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(payment.Description))
                                    {
                                        <div class="text-secondary small text-truncate" style="max-width: 520px;">@payment.Description</div>
                                    }
                                </div>
                            </div>
                        </td>

                        <td class="text-capitalize">
                            <span class="text-secondary">@SharedLocalizer[@payment.PaymentMethodName]</span>
                        </td>

                        <td class="text-capitalize">
                            <span class="text-secondary">@SharedLocalizer[@payment.DocumentTypeName]</span>
                        </td>

                        <td>
                            <div class="d-flex flex-column">
                                <div class="fw-semibold">@payment.EmployeeFullName</div>
                                <div class="text-secondary small">
                                    <i class="ri-time-line me-1"></i>
                                    <span class="js-payment-date" data-payment-utc="@IsoUtc(payment.DateIns)"></span>
                                </div>
                            </div>
                        </td>

                        <td>
                            @{
                                var isToday = payment.DateIns.Date == DateTime.UtcNow.Date;
                                var userIdClaim = User.Claims.FirstOrDefault(c => c.Type == "UserID")?.Value;
                                var isAdmin = User.Claims.Any(c => c.Type == ClaimTypes.Role && c.Value == "CompanyAdmin");
                                var isOwner = userIdClaim == payment.UserID.ToString();
                            }

                            @if (isToday && (isAdmin || isOwner))
                            {
                                <div class="btn-list flex-nowrap">
                                    <button type="button" id="btn-edit-payment" class="btn btn-outline-secondary btn-sm btn-edit-payment"
                                            data-payment-id="@payment.PaymentID" title="Edit">
                                        <i class="ri-pencil-line"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-delete-payment"
                                            data-payment-id="@payment.PaymentID" title="Delete">
                                        <i class="ri-delete-bin-7-line"></i>
                                    </button>
                                </div>
                            }
                        </td>

                    </tr>
                }
            }

            @{
                if (Model.Count() == 0)
                {
                    <tr id="NoPaymentYet">
                        <td colspan="5" class="p-0">
                            <div class="empty">
                                <div class="empty-img">
                                    <img src="~/Img/illustrations/NoDataLoadedYet.png" style="max-height:260px"
                                         alt="@Localizer["No data loaded yet"]" />
                                </div>
                                <p class="empty-title">@Localizer["There are no available records yet!"]</p>
                                <p class="empty-subtitle text-secondary">@Localizer["start creating a new one..."]</p>
                            </div>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>
<script>
    // Apply friendly dates immediately without waiting for document ready
    (function() {
        // Inline function to avoid dependencies on other functions not yet loaded
        function parseAsUtc(input) {
            if (!input) return new Date();
            const str = String(input);
            if (str.includes('Z') && str.includes('.')) {
                const parts = str.split('.');
                if (parts.length === 2) {
                    const datePart = parts[0];
                    const msPart = parts[1].replace('Z', '');
                    const truncatedMs = msPart.substring(0, 3);
                    return new Date(`${datePart}.${truncatedMs}Z`);
                }
            }
            if (/^\d{4}-\d{2}-\d{2}T/.test(str) && !(/[Z+\-]\d{2}:?\d{2}$/.test(str))) {
                return new Date(str + "Z");
            }
            return new Date(str);
        }

        function friendlyDateTime(dateString) {
            const date = parseAsUtc(dateString);
            if (isNaN(date)) return "";
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const dateOnly = new Date(date);
            dateOnly.setHours(0, 0, 0, 0);
            const diffMs = today - dateOnly;
            const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            const timePart = date.toLocaleTimeString("it-IT", { hour: "2-digit", minute: "2-digit" });

            if (diffDays === 0) return `@Html.Raw(SharedLocalizer?["TodayAt"].Value ?? "today at") ${timePart}`;
            if (diffDays === 1) return `@Html.Raw(SharedLocalizer?["YesterdayAt"].Value ?? "yesterday at") ${timePart}`;
            if (diffDays === 2) return `@Html.Raw(SharedLocalizer?["DayBeforeYesterdayAt"].Value ?? "day before yesterday at") ${timePart}`;

            const options = { day: "numeric", month: "short" };
            let datePart = date.toLocaleDateString("it-IT", options);
            if (date.getFullYear() !== today.getFullYear()) {
                datePart += ` ${date.getFullYear()}`;
            }
            return `${datePart} @Html.Raw(SharedLocalizer?["At"].Value ?? "at") ${timePart}`;
        }

        // Find all dates in the newly rendered table
        const table = document.currentScript.previousElementSibling;
        const nodes = table.querySelectorAll('.js-payment-date[data-payment-utc]');
        nodes.forEach(function(node) {
            const raw = node.getAttribute('data-payment-utc');
            if (!raw) return;
            const text = friendlyDateTime(raw).trim();
            if (!text) return;
            node.textContent = text;
        });
    })();
</script>
