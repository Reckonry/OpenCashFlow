@{
    ViewData["Title"] = Localizer["ChangePasswordTitle"].Value;
}

@section PageScripts {
    <script>
        $(function () {
            const form = $('form[action*="ChangePassword"]');
            const newPwd = $('input[name="NewPassword"]');
            const repeatPwd = $('input[name="RepeatPassword"]');
            const submitBtn = $('button[type="submit"]');
            const errorAlert = $('#passwordError');

            // Password strength validation function
            function isStrongPassword(password) {
                if (!password || password.length < 8) return false;
                const hasUpper = /[A-Z]/.test(password);
                const hasLower = /[a-z]/.test(password);
                const hasDigit = /\d/.test(password);
                const hasSpecial = /[^a-zA-Z0-9]/.test(password);
                return hasUpper && hasLower && hasDigit && hasSpecial;
            }

            // Real-time password requirements validation
            newPwd.on('input', function() {
                const password = $(this).val();

                // Check length (min 8 chars)
                const hasLength = password.length >= 8;
                updateRequirement('#req-length', hasLength);

                // Check uppercase
                const hasUppercase = /[A-Z]/.test(password);
                updateRequirement('#req-uppercase', hasUppercase);

                // Check lowercase
                const hasLowercase = /[a-z]/.test(password);
                updateRequirement('#req-lowercase', hasLowercase);

                // Check digit
                const hasDigit = /\d/.test(password);
                updateRequirement('#req-digit', hasDigit);

                // Check special character
                const hasSpecial = /[^a-zA-Z0-9]/.test(password);
                updateRequirement('#req-special', hasSpecial);
            });

            function updateRequirement(selector, isValid) {
                const $elem = $(selector);
                if (isValid) {
                    $elem.removeClass('text-muted').addClass('text-success');
                    $elem.find('i').removeClass('ri-checkbox-blank-circle-line').addClass('ri-checkbox-circle-fill');
                } else {
                    $elem.removeClass('text-success').addClass('text-muted');
                    $elem.find('i').removeClass('ri-checkbox-circle-fill').addClass('ri-checkbox-blank-circle-line');
                }
            }

            // Toggle password visibility
            $('.toggle-password').on('click', function() {
                const target = $(this).data('target');
                const $input = $(target);
                const type = $input.attr('type') === 'password' ? 'text' : 'password';
                $input.attr('type', type);
                $(this).find('i').toggleClass('ri-eye-off-line ri-eye-line');
            });

            // Form validation on submit
            form.on('submit', function(e) {
                errorAlert.addClass('d-none').text('');

                const pwd = newPwd.val();
                const rep = repeatPwd.val();

                // Check if passwords match
                if (pwd !== rep) {
                    e.preventDefault();
                    errorAlert.removeClass('d-none').text('@Localizer["Passwords do not match"]');
                    return false;
                }

                // Check password strength
                if (!isStrongPassword(pwd)) {
                    e.preventDefault();
                    errorAlert.removeClass('d-none').text('@Localizer["PasswordNotMeetRequirements"]');
                    return false;
                }
            });
        });
    </script>
}

<div class="container py-5" style="max-width:580px;">
    <h3 class="mb-2">@Localizer["ChangePasswordHeading"]</h3>
    <p class="text-muted mb-4">@Localizer["ChangePasswordSubtitle"]</p>

    @if (TempData["PasswordChangeSuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["PasswordChangeSuccessMessage"]</div>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div id="passwordError" class="alert alert-danger d-none" role="alert"></div>

    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <div class="input-group input-group-merge">
                <div class="form-floating form-floating-outline">
                    <input type="password" name="NewPassword" id="NewPassword" class="form-control" placeholder="@Localizer["EnterNewPassword"]" aria-label="@Localizer["NewPassword"]" required autocomplete="new-password" />
                    <label>@Localizer["NewPassword"]</label>
                </div>
                <span class="input-group-text cursor-pointer toggle-password" data-target="#NewPassword">
                    <i class="ri-eye-off-line"></i>
                </span>
            </div>
        </div>
        <div class="mb-4">
            <div class="input-group input-group-merge">
                <div class="form-floating form-floating-outline">
                    <input type="password" name="RepeatPassword" id="RepeatPassword" class="form-control" placeholder="@Localizer["ConfirmYourNewPassword"]" aria-label="@Localizer["ConfirmNewPassword"]" required autocomplete="new-password" />
                    <label>@Localizer["ConfirmNewPassword"]</label>
                </div>
                <span class="input-group-text cursor-pointer toggle-password" data-target="#RepeatPassword">
                    <i class="ri-eye-off-line"></i>
                </span>
            </div>
        </div>

        <!-- Password Requirements Hint -->
        <div class="alert alert-warning mb-4" role="alert">
            <strong>@Localizer["PasswordRequirements"]:</strong>
            <ul class="mb-0 mt-2" id="passwordRequirementsList">
                <li id="req-length" class="text-muted">
                    <i class="ri-checkbox-blank-circle-line me-1"></i>
                    <span>@Localizer["MinLength8Chars"]</span>
                </li>
                <li id="req-uppercase" class="text-muted">
                    <i class="ri-checkbox-blank-circle-line me-1"></i>
                    <span>@Localizer["AtLeastOneUppercase"]</span>
                </li>
                <li id="req-lowercase" class="text-muted">
                    <i class="ri-checkbox-blank-circle-line me-1"></i>
                    <span>@Localizer["AtLeastOneLowercase"]</span>
                </li>
                <li id="req-digit" class="text-muted">
                    <i class="ri-checkbox-blank-circle-line me-1"></i>
                    <span>@Localizer["AtLeastOneDigit"]</span>
                </li>
                <li id="req-special" class="text-muted">
                    <i class="ri-checkbox-blank-circle-line me-1"></i>
                    <span>@Localizer["AtLeastOneSpecial"]</span>
                </li>
            </ul>
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-3">@Localizer["ChangePasswordButton"]</button>
    </form>

    <form asp-action="KeepCurrentPassword" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["KeepCurrentPassword"]</button>
    </form>
</div>
