@using System.Linq
@using Shared.Core
@using Shared.DTOs.Employees
@model Employee_Detail_DTO
@{
  ViewData["Title"] = Localizer["UserProfileTitle"].Value;
  var displayName = (Model?.EmployeeSurnameName ?? ($"{Model?.UserFirstName} {Model?.UserLastName}")).Trim();
  if (string.IsNullOrWhiteSpace(displayName))
  {
    displayName = Localizer["FullName"].Value;
  }
  var hasAvatar = !string.IsNullOrWhiteSpace(Model?.UserAvatar);
  var avatarInfo = hasAvatar
    ? (BgColor: string.Empty, TextColor: string.Empty, Initials: string.Empty)
    : AvatarGenerator.GetAvatar(displayName ?? string.Empty);
}

@section VendorStyles{
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.css">
}

@section VendorScripts {
<script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageStyles{
<link rel="stylesheet" href="~/vendor/css/pages/page-profile.css" />
}

@section PageScripts {
<script src="~/js/pages-profile-user.js"></script>
}

@* ************** Content ************** *@
<!-- Header -->
<div class="row">
  <div class="col-12">
    <div class="card mb-6">
      <div class="user-profile-header-banner">
        <img src="~/img/pages/profile-banner.png" alt="@Localizer["ProfileBannerAlt"]" class="rounded-top">
      </div>
      <div class="user-profile-header d-flex flex-column flex-sm-row text-sm-start text-center mb-5">
        <div class="flex-shrink-0 mt-n2 mx-sm-0 mx-auto">
          @if (hasAvatar)
          {
            <img src="@Url.Content(Model?.UserAvatar ?? string.Empty)" alt="@Localizer["UserAvatarAlt"]" class="d-block h-auto ms-0 ms-sm-5 rounded-4 user-profile-img">
          }
          else
          {
            <div class="user-profile-placeholder d-flex align-items-center justify-content-center ms-0 ms-sm-5 rounded-4 user-profile-img"
                 style="background-color:@avatarInfo.BgColor; color:@avatarInfo.TextColor;"
                 role="img" aria-label="@Localizer["UserAvatarAlt"]">
              <span class="user-profile-placeholder__initials">@avatarInfo.Initials</span>
            </div>
          }
        </div>
        <div class="flex-grow-1 mt-4 mt-sm-12">
          <div class="d-flex align-items-md-end align-items-sm-start align-items-center justify-content-md-between justify-content-start mx-5 flex-md-row flex-column gap-6">
            <div class="user-profile-info">
              <h4 class="mb-2">@Html.Raw((Model?.EmployeeSurnameName ?? ($"{Model?.UserFirstName} {Model?.UserLastName}")).Trim())</h4>
              @{ var roleNames = Model?.Roles?.Where(r => r != null && !string.IsNullOrWhiteSpace(r.RoleName)).Select(r => r.RoleName).ToList();
                 string rolesText;
                 if (roleNames != null && roleNames.Any())
                 {
                   var roleDisplayNames = roleNames.Select(roleName =>
                   {
                     var localizedValue = Localizer[$"Role_{roleName}"]?.Value;
                     return string.IsNullOrWhiteSpace(localizedValue) || string.Equals(localizedValue, $"Role_{roleName}", StringComparison.OrdinalIgnoreCase)
                       ? roleName
                       : localizedValue;
                   });
                   rolesText = string.Join(", ", roleDisplayNames);
                 }
                 else if (!string.IsNullOrWhiteSpace(Model?.Role))
                 {
                   var localizedValue = Localizer[$"Role_{Model.Role}"]?.Value;
                   rolesText = string.IsNullOrWhiteSpace(localizedValue) || string.Equals(localizedValue, $"Role_{Model.Role}", StringComparison.OrdinalIgnoreCase)
                     ? Model.Role
                     : localizedValue;
                 }
                 else
                 {
                   rolesText = "-/-";
                 }
                 var locationText = !string.IsNullOrWhiteSpace(Model?.WorkLocation) ? Model.WorkLocation : (Model?.Country ?? "");
                 var joinedText = (Model?.DateIns != default) ? $"{Localizer["Joined"].Value} {Model?.DateIns.ToString("MMMM yyyy")}" : string.Empty; }
              <ul class="list-inline mb-0 d-flex align-items-center flex-wrap justify-content-sm-start justify-content-center gap-4">
                @if (!string.IsNullOrWhiteSpace(rolesText))
                {
                  <li class="list-inline-item">
                    <i class='ri-palette-line me-2 ri-24px'></i><span class="fw-medium">@rolesText</span>
                  </li>
                }
                @if (!string.IsNullOrWhiteSpace(locationText))
                {
                  <li class="list-inline-item">
                    <i class='ri-map-pin-line me-2 ri-24px'></i><span class="fw-medium">@locationText</span>
                  </li>
                }
                @if (!string.IsNullOrWhiteSpace(joinedText))
                {
                  <li class="list-inline-item">
                    <i class='ri-calendar-line me-2 ri-24px'></i><span class="fw-medium"> @joinedText</span>
                  </li>
                }
              </ul>
            </div>
            <a href="~/Account/Edit" class="btn btn-primary" aria-label="@Localizer["EditProfile"]">
              <i class='ri-user-settings-line ri-16px me-2'></i>@Localizer["EditProfile"]
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!--/ Header -->

<!-- Navbar pills -->
<div class="row">
  <div class="col-md-12">
    <div class="nav-align-top">
      <ul class="nav nav-pills flex-column flex-sm-row mb-6 row-gap-2">
        <li class="nav-item"><a class="nav-link active" href="javascript:void(0);"><i class='ri-user-3-line me-2'></i>@Localizer["ProfileTab"]</a></li>
      @*   <li class="nav-item"><a class="nav-link" href="ProfileTeams"><i class='ri-team-line me-2'></i>@Localizer["TeamsTab"]</a></li>
        <li class="nav-item"><a class="nav-link" href="ProfileProjects"><i class='ri-computer-line me-2'></i>@Localizer["ProjectsTab"]</a></li>
        <li class="nav-item"><a class="nav-link" href="ProfileConnections"><i class='ri-link-m me-2'></i>@Localizer["ConnectionsTab"]</a></li> *@
      </ul>
    </div>
  </div>
</div>
<!--/ Navbar pills -->

<!-- User Profile Content -->
<div class="row">
  <div class="col-xl-4 col-lg-5 col-md-5">
    <!-- About User -->
    <div class="card mb-6">
      <div class="card-body">
        <small class="card-text text-uppercase text-muted small">@Localizer["About"]</small>
        <ul class="list-unstyled my-3 py-1">
          <li class="d-flex align-items-center mb-4"><i class="ri-user-3-line ri-24px"></i><span class="fw-medium mx-2">@Localizer["FullName"]:</span> <span>@(Model?.EmployeeSurnameName?.Trim() ?? "-/-")</span></li>
          <li class="d-flex align-items-center mb-4"><i class="ri-check-line ri-24px"></i><span class="fw-medium mx-2">@Localizer["Status"]:</span>
            @if (Model?.IsApproved == true)
            { <span class="badge bg-label-success">@Localizer["Active"]</span> }
            else if (Model?.IsApproved == false)
            { <span class="badge bg-label-warning">@Localizer["NotActive"]</span> }
            else
            { <span>-/-</span> }
          </li>
          <li class="d-flex align-items-center mb-4"><i class="ri-star-smile-line ri-24px"></i><span class="fw-medium mx-2">@Localizer["Role"]:</span>
            @{ var roleNames2 = Model?.Roles?.Where(r => r != null && !string.IsNullOrWhiteSpace(r.RoleName)).Select(r => r.RoleName).ToList();
               string rolesText2;
               if (roleNames2 != null && roleNames2.Any())
               {
                 var roleDisplayNames2 = roleNames2.Select(roleName =>
                 {
                   var localizedValue = Localizer[$"Role_{roleName}"]?.Value;
                   return string.IsNullOrWhiteSpace(localizedValue) || string.Equals(localizedValue, $"Role_{roleName}", StringComparison.OrdinalIgnoreCase)
                     ? roleName
                     : localizedValue;
                 });
                 rolesText2 = string.Join(", ", roleDisplayNames2);
               }
               else if (!string.IsNullOrWhiteSpace(Model?.Role))
               {
                 var localizedValue = Localizer[$"Role_{Model.Role}"]?.Value;
                 rolesText2 = string.IsNullOrWhiteSpace(localizedValue) || string.Equals(localizedValue, $"Role_{Model.Role}", StringComparison.OrdinalIgnoreCase)
                   ? Model.Role
                   : localizedValue;
               }
               else
               {
                 rolesText2 = "-/-";
               } }
            <span>@rolesText2</span>
          </li>
          @if (!string.IsNullOrWhiteSpace(Model?.Country))
          {
            <li class="d-flex align-items-center mb-4"><i class="ri-flag-2-line ri-24px"></i><span class="fw-medium mx-2">@Localizer["Country"]:</span> <span>@Model.Country</span></li>
          }
          @if (!string.IsNullOrWhiteSpace(Model?.Language))
          {
            <li class="d-flex align-items-center mb-2"><i class="ri-translate-2 ri-24px"></i><span class="fw-medium mx-2">@Localizer["Languages"]:</span> <span>@Model.Language</span></li>
          }
        </ul>
        <small class="card-text text-uppercase text-muted small">@Localizer["Contacts"]</small>
        <ul class="list-unstyled my-3 py-1">
          @if (!string.IsNullOrWhiteSpace(Model?.PhoneNumber) || !string.IsNullOrWhiteSpace(Model?.PhoneNumberPrefix))
          {
            <li class="d-flex align-items-center mb-4"><i class="ri-phone-line ri-24px"></i><span class="fw-medium mx-2">@Localizer["Contact"]:</span> <span>@(Model?.PhoneNumberPrefix) @(Model?.PhoneNumber)</span></li>
          }
          @if (!string.IsNullOrWhiteSpace(Model?.Email))
          {
            <li class="d-flex align-items-center mb-2"><i class="ri-mail-open-line ri-24px"></i><span class="fw-medium mx-2">@Localizer["Email"]:</span> <span>@Model.Email</span></li>
          }
        </ul>
        <small class="card-text text-uppercase text-muted small">@Localizer["Organization"]</small>
        <ul class="list-unstyled mb-0 mt-3 pt-1">
          @if (!string.IsNullOrWhiteSpace(Model?.Department))
          {
            <li class="d-flex align-items-center mb-4"><i class="ri-briefcase-3-line ri-24px text-body me-2"></i>
              <div class="d-flex flex-wrap"><span class="fw-medium me-2">@Localizer["Department"]:</span><span>@Model.Department</span></div>
            </li>
          }
          @if (!string.IsNullOrWhiteSpace(Model?.WorkLocation))
          {
            <li class="d-flex align-items-center"><i class="ri-map-pin-2-line ri-24px text-body me-2"></i>
              <div class="d-flex flex-wrap"><span class="fw-medium me-2">@Localizer["WorkLocation"]:</span><span>@Model.WorkLocation</span></div>
            </li>
          }
        </ul>
      </div>
    </div>
    <!--/ About User -->
  </div>

</div>
<!--/ User Profile Content -->
