@using OpenCashFlow.Infrastructure.Persistence.Entities.Core
@using System.Text.Json
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model Core_Credentials
@{
  Layout = "_BlankLayout";
  ViewData["Title"] = Localizer["LoginTitle"].Value;
}

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.css" />
}

@section VendorScripts {
  <script src="~/vendor/libs/&#64;form-validation/popular.js"></script>
  <script src="~/vendor/libs/&#64;form-validation/bootstrap5.js"></script>
  <script src="~/vendor/libs/&#64;form-validation/auto-focus.js"></script>
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
}

@section PageScripts {
  <script>
    'use strict';

    const validationMessages = {
      usernameRequired: @JsonSerializer.Serialize(Localizer["ValidationUsernameRequired"].Value),
      usernameMinLength: @JsonSerializer.Serialize(Localizer["ValidationUsernameMinLength", 3].Value),
      passwordRequired: @JsonSerializer.Serialize(Localizer["ValidationPasswordRequired"].Value),
      passwordMinLength: @JsonSerializer.Serialize(Localizer["ValidationPasswordMinLength", 6].Value)
                    };

    document.addEventListener('DOMContentLoaded', function () {
      const formEl =
        document.getElementById('loginForm') ||
        document.getElementById('formAuthentication');

      if (!formEl) return;

      // Numeric mask (if Cleave is available)
      const numeralMaskEls = document.querySelectorAll('.numeral-mask');
      if (numeralMaskEls.length && window.Cleave) {
        numeralMaskEls.forEach(function (el) {
          new Cleave(el, { numeral: true });
        });
      }

      // ---- UI helpers
      const btnSignIn = document.getElementById('btnSignIn');
      const loading = document.getElementById('Loading');
      const loginError = document.getElementById('loginError');

      function uiStartLoading() {
        if (loading) loading.classList.remove('d-none');
        if (btnSignIn) btnSignIn.classList.add('d-none');
        if (loginError) { loginError.classList.add('d-none'); loginError.textContent = ''; }
      }

      function uiStopLoading() {
        if (loading) loading.classList.add('d-none');
        if (btnSignIn) btnSignIn.classList.remove('d-none');
      }

      function doNativeSubmit() {
        uiStartLoading();
        // Clear loading state if navigation does not happen (e.g., server error)
        setTimeout(uiStopLoading, 25000);
        formEl.submit();
      }

      // ---- FormValidation
      let fvInstance = null;
      if (window.FormValidation && FormValidation.formValidation) {
        fvInstance = FormValidation.formValidation(formEl, {
          fields: {
            // WARNING: use the exact names generated by asp-for (including capitalization)
            Username: {
              validators: {
                notEmpty: { message: validationMessages.usernameRequired },
                stringLength: { min: 3, message: validationMessages.usernameMinLength }
              }
            },
            Password: {
              validators: {
                notEmpty: { message: validationMessages.passwordRequired },
                stringLength: { min: 6, message: validationMessages.passwordMinLength }
              }
            }
          },
          plugins: {
            trigger: new FormValidation.plugins.Trigger(),
            bootstrap5: new FormValidation.plugins.Bootstrap5({
              eleValidClass: '',
              rowSelector: '.mb-5'
            }),
            submitButton: new FormValidation.plugins.SubmitButton(),
            autoFocus: new FormValidation.plugins.AutoFocus()
          },
          init: function (instance) {
            instance.on('plugins.message.placed', function (e) {
              if (e.element.parentElement.classList.contains('input-group')) {
                e.element.parentElement.insertAdjacentElement('afterend', e.messageElement);
              }
            });
          }
        });

        // Validation OK -> native submit
        fvInstance.on('core.form.valid', function () {
          doNativeSubmit();
        });

        // Block native submit until validation outcome
        formEl.addEventListener('submit', function (e) {
          e.preventDefault();
        });

      } else {
        // No validation library: direct native submit
        formEl.addEventListener('submit', function (e) {
          e.preventDefault();
          doNativeSubmit();
        });
      }
    });
  </script>
}
@* ************** Content ************** *@

<div class="authentication-wrapper authentication-cover">
  <!-- Logo -->
  <a href="/" class="auth-cover-brand d-flex align-items-center gap-2">
    <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
    <span class="app-brand-text demo text-heading fw-semibold">@TempData.Peek("appName")</span>
  </a>
  <!-- /Logo -->
  <div class="authentication-inner row m-0">
    <!-- /Left Section -->
    <div class="d-none d-lg-flex col-lg-7 col-xl-8 align-items-center justify-content-center p-12 pb-2">
      <img src="~/img/illustrations/auth-login-illustration-light.png" class="auth-cover-illustration w-100"
        alt="auth-illustration" data-app-light-img="illustrations/auth-login-illustration-light.png"
        data-app-dark-img="illustrations/auth-login-illustration-dark.png" />
    </div>
    <!-- /Left Section -->
    <!-- Login -->
    <div
      class="d-flex col-12 col-lg-5 col-xl-4 align-items-center authentication-bg position-relative py-sm-12 px-12 py-6">
      <div class="w-px-400 mx-auto pt-5 pt-lg-0">
        <h4 class="mb-1">@Localizer["WelcomeTitle", TempData.Peek("appName") as string ?? string.Empty]</h4>
        <p class="mb-5">@Localizer["WelcomeSubtitle"]</p>

        <form id="formAuthentication" method="post" asp-controller="Home" asp-action="Login" novalidate>
          @Html.AntiForgeryToken()

          @if (ViewBag.ErrorMessage != null)
          {
            <div class="alert alert-solid-danger mb-5" role="alert">@ViewBag.ErrorMessage</div>
          }

          <div class="form-floating form-floating-outline mb-5">
            <input type="text" class="form-control" asp-for="Username" placeholder="@Localizer["UsernamePlaceholder"]"
              autofocus>
            <label for="email">@Localizer["UsernameLabel"]</label>
          </div>
          <div class="mb-5">
            <div class="form-password-toggle">
              <div class="input-group input-group-merge">
                <div class="form-floating form-floating-outline">
                  <input type="password" class="form-control" asp-for="Password"
                    placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                    aria-describedby="password" />
                  <label for="password">@Localizer["PasswordLabel"]</label>
                </div>
                <span class="input-group-text cursor-pointer"><i class="ri-eye-off-line"></i></span>
              </div>
            </div>
          </div>
          <div class="mb-5 d-flex justify-content-between mt-5">
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" asp-for="RememberMe">
              <label class="form-check-label" for="remember-me">
                @Localizer["RememberMe"]
              </label>
            </div>
            @*  <a href="/Account/ForgotPassword" class="float-end mb-1 mt-2">
                            <span>@Localizer["ForgotPassword"]</span>
                        </a> *@
          </div>

          <div id="loginError" class="alert alert-danger d-none mt-2"></div>
          <button class="btn btn-primary d-grid w-100" type="submit" id="btnSignIn">
            @Localizer["SignInButton"]
          </button>
          <button class="btn btn-raised btn-success w-100 d-none" id="Loading" type="button" disabled="">
            <span class="spinner-border spinner-border-sm me-2" role="status"
              aria-hidden="true"></span>@Localizer["Loading"]
          </button>
        </form>


      </div>
    </div>
    <!-- /Login -->
  </div>
</div>
