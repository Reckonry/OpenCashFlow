@using Shared.Core
@using System.Security.Claims;

@{
    TempData.Keep();
    bool isHorizontal = TempData.Peek("menuHorizontal") is bool menuHorizontal && menuHorizontal;
    bool showBrand = ViewData["navbarFull"] is bool navbarFull && navbarFull;
}

@if (isHorizontal)
{
    <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbar-menu"
        aria-controls="navbar-menu"
        aria-expanded="false"
        aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
}

@if (showBrand)
{
    <div class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
        <a asp-controller="Dashboards" asp-action="Index" class="d-flex align-items-center gap-2" aria-label="@TempData.Peek("appName")">
            <span class="navbar-brand-image">
                @await Html.PartialAsync("../_Partials/_Macros")
            </span>
            <span class="fw-semibold">@TempData.Peek("appName")</span>
        </a>
    </div>
}

@if (!isHorizontal)
{
    <form class="d-none d-md-flex ms-3" role="search">
        <input type="search" class="form-control" placeholder="@Localizer["Search"]" aria-label="@Localizer["Search"]" />
    </form>
}

<div class="navbar-nav flex-row order-md-last ms-auto">
    <div class="nav-item d-none d-md-flex me-3">
        <div class="nav-link px-0">
            <a href="?theme=dark" class="nav-link px-0 hide-theme-dark" title="Enable dark mode" data-bs-toggle="tooltip" data-bs-placement="bottom">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                    class="icon icon-1">
                    <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008" />
                </svg>
            </a>
            <a href="?theme=light" class="nav-link px-0 hide-theme-light" title="Enable light mode" data-bs-toggle="tooltip" data-bs-placement="bottom">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                    class="icon icon-1">
                    <path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                    <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
                </svg>
            </a>
        </div>
    </div>

    <div class="nav-item dropdown">
        <a class="nav-link d-flex lh-1 text-reset p-0" href="javascript:void(0);" data-bs-toggle="dropdown" aria-label="Open user menu">
            <span class="avatar avatar-sm">
                @{
                    if (!string.IsNullOrEmpty(User.FindFirst("Avatar")?.Value))
                    {
                        <img src="@Url.Content(User.FindFirst("Avatar")?.Value)" alt="@User.FindFirst("FullName")?.Value" class="rounded-circle" />
                    }
                    else
                    {
                        var (bgColor, textColor, initials) =
                            AvatarGenerator.GetAvatar(User.FindFirst(ClaimTypes.Surname)?.Value + " " +
                                                     User.FindFirst(ClaimTypes.Name)?.Value);
                        <span class="avatar-initial rounded-circle" style="background-color:@bgColor; color:@textColor">
                            @initials
                        </span>
                    }
                }
            </span>
            <div class="d-none d-xl-block ps-2">
                <div class="text-truncate">@User.FindFirst("FullName")?.Value</div>
                <div class="mt-1 small text-secondary">@Localizer["Role_" + (User.FindFirst(ClaimTypes.Role)?.Value ?? "User")]</div>
            </div>
        </a>
        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
            <div class="dropdown-item-text">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm me-2">
                        @{
                            if (!string.IsNullOrEmpty(User.FindFirst("Avatar")?.Value))
                            {
                                <img src="@Url.Content(User.FindFirst("Avatar")?.Value)" alt="@User.FindFirst("FullName")?.Value" class="rounded-circle" />
                            }
                            else
                            {
                                var (bgColor, textColor, initials) =
                                    AvatarGenerator.GetAvatar(User.FindFirst(ClaimTypes.Surname)?.Value + " " +
                                                             User.FindFirst(ClaimTypes.Name)?.Value);
                                <span class="avatar-initial rounded-circle" style="background-color:@bgColor; color:@textColor">
                                    @initials
                                </span>
                            }
                        }
                    </span>
                    <div>
                        <div class="text-truncate">@User.FindFirst("FullName")?.Value</div>
                        <div class="small text-secondary">@Localizer["Role_" + (User.FindFirst(ClaimTypes.Role)?.Value ?? "User")]</div>
                    </div>
                </div>
            </div>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href="~/Account">@Localizer["Account"]</a>
            <a class="dropdown-item" href="~/Account/Edit">@Localizer["Settings"]</a>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href="~/Account/Disconnect">@Localizer["Lock"]</a>
            <a class="dropdown-item" href="~/Account/Logout">@Localizer["Logout"]</a>
        </div>
    </div>
</div>
