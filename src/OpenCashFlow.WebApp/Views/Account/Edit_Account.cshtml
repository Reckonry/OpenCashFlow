@using OpenCashFlow.Contracts.DTOs.Employees
@model Employee_MyProfile_Update_DTO
@{
    ViewData["Title"] = Localizer["EditAccountTitle"].Value;
}

<div class="container-xl">

  <div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
      <div class="col">
        <h2 class="page-title">@Localizer["AccountSettings"]</h2>
        <div class="text-secondary mt-1">@Localizer["EditAccountTitle"]</div>
      </div>
    </div>
  </div>

  @if (ViewBag.SuccessMessage != null)
  {
    <div class="alert alert-success alert-dismissible" role="alert">
      <div class="d-flex">
        <div class="me-3">
          <i class="ri-checkbox-circle-line fs-3 text-success"></i>
        </div>
        <div class="flex-fill">
          @ViewBag.SuccessMessage
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  }
  @if (ViewBag.ErrorMessage != null)
  {
    <div class="alert alert-danger" role="alert">
      <div class="d-flex">
        <div class="me-3">
          <i class="ri-error-warning-line fs-3 text-danger"></i>
        </div>
        <div class="flex-fill">
          @ViewBag.ErrorMessage
        </div>
      </div>
    </div>
  }

  <div class="row row-cards">

    @* Account details *@
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0">@Localizer["AccountSettings"]</h3>
        </div>

        <div class="card-body">
          <form asp-action="Edit_Account" asp-controller="Account" method="post" class="fv-plugins-bootstrap5 fv-plugins-framework">
            @Html.AntiForgeryToken()

            <div class="row g-3">

              <div class="col-md-6 form-control-validation fv-plugins-icon-container">
                <div class="form-floating">
                  <input class="form-control" type="text" asp-for="UserFirstName" autofocus="" placeholder="@Localizer["EnterYourFirstName"]" aria-label="@Localizer["FirstName"]">
                  <label asp-for="UserFirstName">@Localizer["FirstName"]</label>
                </div>
                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
              </div>

              <div class="col-md-6 form-control-validation fv-plugins-icon-container">
                <div class="form-floating">
                  <input class="form-control" type="text" asp-for="UserLastName" placeholder="@Localizer["EnterYourLastName"]" aria-label="@Localizer["LastName"]">
                  <label asp-for="UserLastName">@Localizer["LastName"]</label>
                </div>
                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
              </div>

              <div class="col-md-6">
                <div class="form-floating">
                  <input class="form-control" type="text" asp-for="Email" disabled placeholder="@Localizer["EmailPlaceholder"]" aria-label="@Localizer["Email"]">
                  <label for="email">@Localizer["Email"]</label>
                </div>
              </div>

              <div class="col-md-6">
                <div class="row g-2">
                  <div class="col-4">
                    <div class="form-floating">
                      <select class="form-select" asp-for="PhoneNumberPrefix" aria-label="@Localizer["Prefix"]">
                        <option value="">@Localizer["Prefix"]</option>
                        <option value="+39">IT (+39)</option>
                        <option value="+33">FR (+33)</option>
                        <option value="+49">DE (+49)</option>
                        <option value="+44">UK (+44)</option>
                        <option value="+1">US (+1)</option>
                      </select>
                      <label asp-for="PhoneNumberPrefix">@Localizer["Prefix"]</label>
                    </div>
                  </div>
                  <div class="col-8">
                    <div class="form-floating">
                      <input type="text" class="form-control" asp-for="PhoneNumber" placeholder="@Localizer["EnterYourPhoneNumber"]" aria-label="@Localizer["PhoneNumber"]">
                      <label asp-for="PhoneNumber">@Localizer["PhoneNumber"]</label>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-floating">
                  <select class="form-select" asp-for="Language" aria-label="@Localizer["Language"]">
                    <option value="it">@Localizer["Italian"]</option>
                    <option value="en">@Localizer["English"]</option>
                    <option value="fr">@Localizer["French"]</option>
                    <option value="de">@Localizer["German"]</option>
                  </select>
                  <label asp-for="Language">@Localizer["Language"]</label>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-floating">
                  <select class="form-select" asp-for="Country" aria-label="@Localizer["Country"]">
                    <option value="IT">@Localizer["Italy"]</option>
                    <option value="FR">@Localizer["France"]</option>
                    <option value="DE">@Localizer["Germany"]</option>
                    <option value="GB">@Localizer["UnitedKingdom"]</option>
                    <option value="US">@Localizer["UnitedStates"]</option>
                  </select>
                  <label asp-for="Country">@Localizer["Country"]</label>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-floating">
                  <select class="form-select" asp-for="Timezone" aria-label="@Localizer["Timezone"]">
                    <option value="">@Localizer["SelectTimezone"]</option>
                    <option value="UTC">UTC</option>
                    <option value="Europe/Rome">(UTC+01:00) Europe/Rome</option>
                    <option value="Europe/Paris">(UTC+01:00) Europe/Paris</option>
                    <option value="Europe/Berlin">(UTC+01:00) Europe/Berlin</option>
                    <option value="Europe/London">(UTC+00:00) Europe/London</option>
                    <option value="America/New_York">(UTC-05:00) America/New_York</option>
                  </select>
                  <label asp-for="Timezone">@Localizer["Timezone"]</label>
                </div>
              </div>

            </div>

            <div class="mt-4 btn-list">
              <button type="submit" class="btn btn-primary" aria-label="@Localizer["SaveChanges"]">
                <i class="ri-save-line me-1"></i>@Localizer["SaveChanges"]
              </button>
              <button type="reset" class="btn btn-outline-secondary" aria-label="@Localizer["Reset"]">
                @Localizer["Reset"]
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>

    @* Change password *@
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0">@Localizer["ChangePassword"]</h3>
        </div>
        <div class="card-body">
          <form asp-action="ChangePassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div class="form-floating mb-3">
              <input class="form-control" type="password" name="NewPassword" placeholder="@Localizer["EnterNewPassword"]" aria-label="@Localizer["NewPassword"]" />
              <label>@Localizer["NewPassword"]</label>
            </div>
            <div class="form-floating mb-3">
              <input class="form-control" type="password" name="RepeatPassword" placeholder="@Localizer["RepeatNewPassword"]" aria-label="@Localizer["RepeatNewPassword"]" />
              <label>@Localizer["RepeatNewPassword"]</label>
            </div>
            <div class="mt-3">
              <button class="btn btn-warning" type="submit" aria-label="@Localizer["UpdatePassword"]">
                <i class="ri-key-2-line me-1"></i>@Localizer["UpdatePassword"]
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
// Auto-hide success alerts after 3 seconds and reload navbar to show updated name
$(document).ready(function() {
  $('.alert-success').each(function() {
    var alert = $(this);

    // Reload page to refresh navbar with updated user info
    setTimeout(function() {
      window.location.reload();
    }, 1500);

    setTimeout(function() {
      alert.fadeOut('slow');
    }, 3000);
  });
});
</script>
