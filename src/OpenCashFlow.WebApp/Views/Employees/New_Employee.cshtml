@using OpenCashFlow.Contracts.DTOs.Employees
@model Employee_Create_DTO
@{
	ViewData["Title"] = Localizer["NewEmployeeTitle"].Value;
}

@section VendorStyles {
	<link rel="stylesheet" href="~/vendor/libs/quill/typography.css">
	<link rel="stylesheet" href="~/vendor/libs/quill/katex.css">
	<link rel="stylesheet" href="~/vendor/libs/quill/editor.css">
	<link rel="stylesheet" href="~/vendor/libs/select2/select2.css">
	<link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.css">
	<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css">
}

@section VendorScripts {
	<script src="~/vendor/libs/quill/katex.js"></script>
	<script src="~/vendor/libs/quill/quill.js"></script>
	<script src="~/vendor/libs/select2/select2.js"></script>
	<script src="~/vendor/libs/dropzone/dropzone.js"></script>
	<script src="~/vendor/libs/jquery-repeater/jquery-repeater.js"></script>
	<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@section PageScripts {
    <script src="~/js/app-ecommerce-product-add.js"></script>
	
	<script>
        $(document).on('submit', '#createEmployeeForm', function (e) {
            // 1. Reset errors
            $('.text-danger').text('');
            $('.is-invalid').removeClass('is-invalid');

			let isValid = true;

			// Required fields
            const requiredFields = [
                { id: '#UserFirstName', name: 'UserFirstName', message: '@Localizer["Insert a first name"]' },
                { id: '#UserLastName', name: 'UserLastName', message: '@Localizer["Insert a last name"]' },
                { id: '#Email', name: 'Email', message: '@Localizer["Insert a valid e-mail"]' },
                { id: '#TmpNewPassword', name: 'TmpNewPassword', message: '@Localizer["Insert a password"]' },
                { id: '#TmpNewPasswordRepeat', name: 'TmpNewPasswordRepeat', message: '@Localizer["Repeat the password"]' },
            ];

			requiredFields.forEach(f => {
				const value = $(f.id).val()?.trim();
				if (!value || value === '00000000-0000-0000-0000-000000000000') {
					isValid = false;
					$(f.id).addClass('is-invalid');
					$(`span[data-valmsg-for='${f.name}']`).text(f.message);
				}
			});

			// const emailVal = $('#Email').val()?.trim();
			// const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
			// if (emailVal && !emailRegex.test(emailVal)) {
			// 	isValid = false;
			// 	$('#Email').addClass('is-invalid');
			// 	$("span[data-valmsg-for='Email']").text('@Localizer["The email you wrote is invalid"]');
			// }


            // Password match
            const pwd = $('#TmpNewPassword').val();
            const rep = $('#TmpNewPasswordRepeat').val();
            if (pwd !== rep) {
                isValid = false;
                $('#TmpNewPassword, #TmpNewPasswordRepeat').addClass('is-invalid');
                $(`span[data-valmsg-for='TmpNewPasswordRepeat']`).text('@Localizer["Passwords do not match"]');
            }

			// Password strength validation
			if (pwd && !isStrongPassword(pwd)) {
				isValid = false;
				$('#TmpNewPassword').addClass('is-invalid');
				$(`span[data-valmsg-for='TmpNewPassword']`).text('@Localizer["PasswordNotMeetRequirements"]');
			}

			// If not valid, block submit
			if (!isValid) {
				e.preventDefault(); // <-- block only if there are errors
				return false;
			}

			// Show loader (only if valid)
			$('#SubmitButton').addClass('d-none');
			$('#Loading').removeClass('d-none');
		});
	</script>

	<script>
		// new Cleave(".date-dob", {
		// 	date: true, delimiter: "/",
		// 	datePattern: ["d", "m", "Y"]
		// });

		// new Cleave('.input-mobile', {
		// 	phone: true, phoneRegionCode: 'it', blocks: [3, 3, 3, 2]
		// });

		// new Cleave(".numeral-price", {
		// 	numeral: true,
		// 	numeralThousandsGroupStyle: 'thousand',
		// 	numeralDecimalMark: ',',
		// 	delimiter: '.'
		// });

	</script>
	<script>
		// Toggle password visibility
		$(function () {
			const toggle = (btnId, inputSelector) => {
				$(btnId).on('click', function () {
					const $inp = $(inputSelector);
					const type = $inp.attr('type') === 'password' ? 'text' : 'password';
					$inp.attr('type', type);
					$(this).find('i').toggleClass('ri-eye-off-line ri-eye-line');
				});
			};
			toggle('#togglePwd1', '#TmpNewPassword');
			toggle('#togglePwd2', '#TmpNewPasswordRepeat');

			// Password strength validation in real-time
			$('#TmpNewPassword').on('input', function() {
				const password = $(this).val();

				// Check length (min 8 chars)
				const hasLength = password.length >= 8;
				updateRequirement('#req-length', hasLength);

				// Check uppercase
				const hasUppercase = /[A-Z]/.test(password);
				updateRequirement('#req-uppercase', hasUppercase);

				// Check lowercase
				const hasLowercase = /[a-z]/.test(password);
				updateRequirement('#req-lowercase', hasLowercase);

				// Check digit
				const hasDigit = /\d/.test(password);
				updateRequirement('#req-digit', hasDigit);

				// Check special character
				const hasSpecial = /[^a-zA-Z0-9]/.test(password);
				updateRequirement('#req-special', hasSpecial);
			});

			function updateRequirement(selector, isValid) {
				const $elem = $(selector);
				if (isValid) {
					$elem.removeClass('text-muted').addClass('text-success');
					$elem.find('i').removeClass('ri-checkbox-blank-circle-line').addClass('ri-checkbox-circle-fill');
				} else {
					$elem.removeClass('text-success').addClass('text-muted');
					$elem.find('i').removeClass('ri-checkbox-circle-fill').addClass('ri-checkbox-blank-circle-line');
				}
			}
		});
	</script>
	<script>
		// Client-side password validation
		function isStrongPassword(password) {
			if (!password || password.length < 8) return false;
			const hasUpper = /[A-Z]/.test(password);
			const hasLower = /[a-z]/.test(password);
			const hasDigit = /\d/.test(password);
			const hasSpecial = /[^a-zA-Z0-9]/.test(password);
			return hasUpper && hasLower && hasDigit && hasSpecial;
		}
	</script>
}


@Html.Raw(ViewBag.ResponseMessage)


@* Page header (Tabler style) *@
<div class="page-header d-print-none mb-4">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">@Localizer["Add new Employee"]</h2>
      <div class="text-secondary mt-1">@Localizer["Subtitle"]</div>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="btn-list">
        <a href="~/Employees" class="btn btn-outline-secondary">
          <i class="ri-arrow-go-back-fill"></i>
          <span class="d-none d-sm-inline ms-1">@Localizer["Discard"]</span>
        </a>
      </div>
    </div>
  </div>
</div>

<form method="post" id="createEmployeeForm">
  @Html.AntiForgeryToken()

  <div class="row row-cards">

    @* Left column *@
    <div class="col-12 col-lg-8">

      @* User basic *@
      <div class="card mb-4">
        <div class="card-header">
          <h3 class="card-title">@Localizer["User basic"]</h3>
        </div>
        <div class="card-body">

          <div class="mb-3">
            <label class="form-label" for="SelectedRoleID">@Localizer["Role"]</label>
            <select class="form-select" asp-for="SelectedRoleID" id="SelectedRoleID">
              <option value="">@Localizer["Select a role"]</option>
              @{
                if (ViewBag.Roles is IEnumerable<OpenCashFlow.Contracts.DTOs.Identity.Role_List_DTO> roles)
                {
                  foreach (var role in roles)
                  {
                    <option value="@role.ID">@Localizer["role_" + role.Name]</option>
                  }
                }
              }
            </select>
            <small><span asp-validation-for="SelectedRoleID" class="text-danger"></span></small>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="UserFirstName">@Localizer["Name"]</label>
              <input type="text" asp-for="UserFirstName" id="UserFirstName" class="form-control form-lowercase" placeholder="@Localizer["Name"]" autocomplete="off" />
              <small><span asp-validation-for="UserFirstName" class="text-danger"></span></small>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="UserLastName">@Localizer["Surname"]</label>
              <input type="text" asp-for="UserLastName" id="UserLastName" class="form-control form-lowercase" placeholder="@Localizer["Surname"]" autocomplete="off" />
              <small><span asp-validation-for="UserLastName" class="text-danger"></span></small>
            </div>
          </div>

        </div>
      </div>

      @* Security info *@
      <div class="card mb-4">
        <div class="card-header">
          <h3 class="card-title">@Localizer["Security Info"]</h3>
        </div>
        <div class="card-body">

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="PhoneNumber">@Localizer["Phone number"]</label>
              <div class="input-group">
                <span class="input-group-text"><i class="ri-phone-line"></i></span>
                <input type="text" class="form-control" asp-for="PhoneNumber" id="PhoneNumber" placeholder="@Localizer["Phone number"]" />
              </div>
              <small><span asp-validation-for="PhoneNumber" class="text-danger"></span></small>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="Email">@Localizer["E-mail"]</label>
              <div class="input-group">
                <span class="input-group-text"><i class="ri-mail-open-line"></i></span>
                <input type="text" class="form-control" asp-for="Email" id="Email" placeholder="@Localizer["E-mail"]" />
              </div>
              <small><span asp-validation-for="Email" class="text-danger"></span></small>
            </div>
          </div>

          <div class="alert alert-info d-flex align-items-center mt-4" role="alert">
            <i class="ri-information-line me-2"></i>
            <div class="flex-grow-1">@Localizer["PasswordInfoMessage"]</div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-md-6">
              <label class="form-label" for="TmpNewPassword">@Localizer["Password"]</label>
              <div class="input-group">
                <span class="input-group-text"><i class="ri-lock-password-line"></i></span>
                <input type="password" class="form-control" asp-for="TmpNewPassword" id="TmpNewPassword" placeholder="@Localizer["Password"]" autocomplete="new-password" />
                <button class="btn btn-outline-secondary" type="button" id="togglePwd1" aria-label="Toggle password">
                  <i class="ri-eye-off-line"></i>
                </button>
              </div>
              <small><span asp-validation-for="TmpNewPassword" class="text-danger"></span></small>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="TmpNewPasswordRepeat">@Localizer["Repeat Password"]</label>
              <div class="input-group">
                <span class="input-group-text"><i class="ri-lock-password-line"></i></span>
                <input type="password" class="form-control" asp-for="TmpNewPasswordRepeat" id="TmpNewPasswordRepeat" placeholder="@Localizer["Repeat Password"]" autocomplete="new-password" />
                <button class="btn btn-outline-secondary" type="button" id="togglePwd2" aria-label="Toggle password">
                  <i class="ri-eye-off-line"></i>
                </button>
              </div>
              <small><span asp-validation-for="TmpNewPasswordRepeat" class="text-danger"></span></small>
            </div>
          </div>

          <div class="alert alert-warning mt-4" role="alert">
            <strong>@Localizer["PasswordRequirements"]:</strong>
            <ul class="mb-0 mt-2" id="passwordRequirementsList">
              <li id="req-length" class="text-muted">
                <i class="ri-checkbox-blank-circle-line me-1"></i>
                <span>@Localizer["MinLength8Chars"]</span>
              </li>
              <li id="req-uppercase" class="text-muted">
                <i class="ri-checkbox-blank-circle-line me-1"></i>
                <span>@Localizer["AtLeastOneUppercase"]</span>
              </li>
              <li id="req-lowercase" class="text-muted">
                <i class="ri-checkbox-blank-circle-line me-1"></i>
                <span>@Localizer["AtLeastOneLowercase"]</span>
              </li>
              <li id="req-digit" class="text-muted">
                <i class="ri-checkbox-blank-circle-line me-1"></i>
                <span>@Localizer["AtLeastOneDigit"]</span>
              </li>
              <li id="req-special" class="text-muted">
                <i class="ri-checkbox-blank-circle-line me-1"></i>
                <span>@Localizer["AtLeastOneSpecial"]</span>
              </li>
            </ul>
          </div>

        </div>
      </div>

    </div>

    @* Right column *@
    <div class="col-12 col-lg-4">

      <div class="card mb-4">
        <div class="card-header">
          <h3 class="card-title">@Localizer["Other Info"]</h3>
        </div>
        <div class="card-body">

          <div class="mb-3">
            <label class="form-label" for="Gender">@Localizer["Gender"]</label>
            <select class="form-select" asp-for="Gender" id="Gender">
              <option value="">@Localizer["Select gender"]</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label" for="Timezone">@Localizer["Timezone"]</label>
            <select class="form-select" asp-for="Timezone" id="Timezone">
              <option value="">@Localizer["Select a timezone"]</option>
              @{
                if (ViewBag.Timezones != null)
                {
                  foreach (var item in ViewBag.Timezones)
                  {
                    <option value="@item.Display">@item.Display</option>
                  }
                }
              }
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label" for="Language">@Localizer["Language"]</label>
            <select class="form-select" asp-for="Language" id="Language">
              <option value="">@Localizer["SelectALanguage"]</option>
              @{
                if (ViewBag.Languages != null)
                {
                  foreach (var item in ViewBag.Languages)
                  {
                    <option value="@item.Code">@item.Name</option>
                  }
                }
              }
            </select>
            <small><span asp-validation-for="Language" class="text-danger"></span></small>
          </div>

          <div class="mb-3">
            <label class="form-label" for="Country">@Localizer["Country"]</label>
            <select class="form-select" asp-for="Country" id="Country">
              <option value="">@Localizer["SelectACountry"]</option>
              @{
                if (ViewBag.Countries != null)
                {
                  foreach (var item in ViewBag.Countries)
                  {
                    <option value="@item.Code">@item.Name</option>
                  }
                }
              }
            </select>
            <small><span asp-validation-for="Country" class="text-danger"></span></small>
          </div>

          <div class="d-flex justify-content-between align-items-center border-top pt-3">
            <div>
              <div class="fw-semibold">@Localizer["Utente Attivo"]</div>
              <div class="text-secondary small">@Localizer["UserIsActiveHint"]</div>
            </div>
            <div class="form-check form-switch m-0">
              <input type="checkbox" class="form-check-input" checked />
            </div>
          </div>

        </div>
      </div>

      <div class="d-grid gap-2">
        <button id="SubmitButton" type="submit" class="btn btn-success">
          <i class="ri-add-large-line me-2"></i>@Localizer["Create"]
        </button>
        <button class="btn btn-success d-none" id="Loading" type="button" disabled>
          <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@Localizer["Loading"]
        </button>
      </div>

      <div class="d-grid gap-2 pt-3">
        <a href="~/Employees" class="btn btn-outline-secondary">
          <i class="ri-arrow-go-back-fill me-2"></i>@Localizer["Discard"]
        </a>
      </div>

    </div>

  </div>
</form>
