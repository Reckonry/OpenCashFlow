@{
    Layout = "_BlankLayout";
    ViewData["Title"] = Localizer["ForgotPasswordTitle"].Value;
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/&#64;form-validation/popular.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
}

@section PageScripts {
    <script src="~/js/pages-auth.js"></script>
}
@* ************** Content ************** *@

<div class="page page-center">
  <div class="container container-tight py-4">

    <div class="text-center mb-4">
      <a href="/" aria-label="@((TempData.Peek("appName") as string) ?? "OpenCashFlow")" class="navbar-brand navbar-brand-autodark">
        <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
        <span class="app-brand-text demo text-heading fw-semibold ms-2">@TempData.Peek("appName")</span>
      </a>
    </div>

    <div class="card card-md">
      <div class="card-body">

        <h2 class="card-title text-center mb-4">@Localizer["ForgotPasswordHeading"]</h2>
        <p class="text-secondary mb-4 text-center">@Localizer["ForgotPasswordSubtitle"]</p>

        @if (ViewBag.EmailSent == true)
        {
          <div class="alert alert-success text-center" role="alert">
            <h5 class="alert-heading fw-bold mb-2">@ViewBag.SuccessTitle</h5>
            <p class="mb-0">@ViewBag.SuccessMessage</p>
          </div>

          <div class="text-center mt-4">
            <a href="/Account/ForgotPassword" class="btn btn-primary w-100">
              @Localizer["SendAgain"]
            </a>
          </div>
        }
        else
        {
          @if (ViewBag.ErrorMessage != null)
          {
            <div class="alert alert-danger text-center mb-4" role="alert">
              <h5 class="alert-heading fw-bold mb-2">@ViewBag.ErrorTitle ?? "Error"</h5>
              <p class="mb-0">@ViewBag.ErrorMessage</p>
            </div>
          }

          <form id="formAuthentication" method="POST" autocomplete="off" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
              <label class="form-label" for="email">@Localizer["Email"]</label>
              <input type="email"
                     class="form-control"
                     id="email"
                     name="email"
                     placeholder="@Localizer["EnterYourEmail"]"
                     required
                     autofocus />
            </div>

            <div class="form-footer">
              <button type="submit" class="btn btn-primary w-100">
                @Localizer["SendResetLink"]
              </button>
            </div>
          </form>
        }

      </div>
    </div>

    <div class="text-center text-secondary mt-3">
      @Localizer["BackToLoginText"]
      <a href="/">@Localizer["BackToLogin"]</a>
    </div>

  </div>
</div>
