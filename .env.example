# OpenCashFlow - Environment Variables Example

# Database
DEFAULT_CONN_STRING=Host=localhost;Database=opencashflow_db;Username=opencashflow;Password=YourPassword

# Stripe Configuration (Test Mode)
STRIPE__SECRETKEY=sk_test_your_test_secret_key_here
STRIPE__PUBLISHABLEKEY=pk_test_your_test_publishable_key_here
STRIPE__WEBHOOKSECRET=whsec_your_webhook_secret_here

# Stripe Configuration (Production)
# STRIPE__SECRETKEY=sk_live_your_live_secret_key_here
# STRIPE__PUBLISHABLEKEY=pk_live_your_live_publishable_key_here
# STRIPE__WEBHOOKSECRET=whsec_your_production_webhook_secret_here

# JWT Settings (Change in production!)
JWTSETTINGS__SECRETKEY=your_jwt_secret_key_at_least_64_characters_long_for_security

# Email Configuration
EMAILCONFIGURATION__PASSWORD=your_smtp_password_here

# Sentry (Optional)
SENTRY__DSN=your_sentry_dsn_here

# Application URLs
APPURL=https://localhost:7001
CORS__ALLOWEDORIGINS__0=https://localhost:7001
CORS__ALLOWEDORIGINS__1=https://localhost:7002

# Notes:
# - Never commit actual secrets to Git
# - Copy this file to .env and fill in your actual values
# - Use Test Mode keys during development
# - Rotate all secrets before going to production
