@using Shared.DTOs.Employees
@model Employee_Detail_DTO

<div class="card">
  <div class="card-body">

    <div class="text-uppercase text-secondary fw-semibold small mb-2">@Localizer["About"]</div>

    <dl class="row mb-4">
      <dt class="col-4 text-secondary">@Localizer["Full Name"]</dt>
      <dd class="col-8 mb-2">@Model?.EmployeeSurnameName?.Trim()</dd>

      <dt class="col-4 text-secondary">@Localizer["Username"]</dt>
      <dd class="col-8 mb-2">@Model?.UserName?.Trim()</dd>

      <dt class="col-4 text-secondary">@Localizer["Status"]</dt>
      <dd class="col-8 mb-2">
        @{
          if (Model?.IsApproved == true)
          {
            <span class="badge bg-green-lt">@Localizer["Active"]</span>
          }
          else if (Model?.IsApproved == false)
          {
            <span class="badge bg-yellow-lt">@Localizer["Not Active"]</span>
          }
        }
      </dd>

      <dt class="col-4 text-secondary">@Localizer["Check In"]</dt>
      <dd class="col-8 mb-2">
        @{
          // if (Model.RequireShiftCheckIn)
          // {
          //     <span class="badge bg-yellow-lt">@Localizer["Required"]</span>
          // }
          // else
          // {
          //     <span class="badge bg-azure-lt">@Localizer["Not Required"]</span>
          // }
          <span class="text-secondary">-/-</span>
        }
      </dd>

      <dt class="col-4 text-secondary">@Localizer["Role"]</dt>
      <dd class="col-8 mb-2">
        @{
          var roles = Model?.Roles;
          if (roles != null && roles.Count > 0)
          {
            foreach (var role in roles)
            {
              if (role == null || string.IsNullOrWhiteSpace(role.RoleName))
              {
                continue;
              }
              <span class="badge bg-azure-lt me-1">@Localizer["Role_" + role.RoleName]</span>
            }
          }
          else
          {
            <span class="text-secondary">-/-</span>
          }
        }
      </dd>

      @if (!string.IsNullOrEmpty(Model?.Language))
      {
        <dt class="col-4 text-secondary">@Localizer["Language"]</dt>
        <dd class="col-8 mb-2">@Model?.Language?.Trim()</dd>
      }

    </dl>

    <div class="text-uppercase text-secondary fw-semibold small mb-2">@Localizer["Contacts"]</div>

    <dl class="row mb-0">

      @if (!string.IsNullOrEmpty(Model?.PhoneNumber))
      {
        <dt class="col-4 text-secondary">@Localizer["Phone"]</dt>
        <dd class="col-8 mb-2">
          <span>@Model?.PhoneNumberPrefix?.Trim() @Model?.PhoneNumber?.Trim()</span>
          @{
            if (Model?.PhoneNumberConfirmed == true)
            {
              <a class="ms-2" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="tooltip-success" data-bs-original-title="@Localizer["Phone confirmed"]">
                <i class='ti ti-circle-check text-success'></i>
              </a>
            }
          }
        </dd>
      }

      @if (!string.IsNullOrEmpty(Model?.Email))
      {
        <dt class="col-4 text-secondary">@Localizer["E-mail"]</dt>
        <dd class="col-8 mb-0">
          <span>@Model?.Email?.Trim()</span>
          @{
            if (Model?.EmailConfirmed == true)
            {
              <a class="ms-2" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="tooltip-success" data-bs-original-title="@Localizer["E-mail confirmed"]">
                <i class='ti ti-circle-check text-success'></i>
              </a>
            }
          }
        </dd>
      }

    </dl>

  </div>
</div>
