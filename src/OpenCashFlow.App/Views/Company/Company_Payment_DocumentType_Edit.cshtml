@model Payment_DocumentType_Update_DTO
@{
    ViewData["Title"] = Localizer["DocumentTypeEditTitle"].Value;
}

@await Html.PartialAsync("Components/_Company_ViewHeader", ViewData)

<div class="page-header d-print-none mb-4">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">@Localizer["DocumentTypeEditTitle"]</h2>
      <div class="text-secondary mt-1">@Localizer["DocumentTypeExplanation"]</div>
    </div>
  </div>
</div>

<div class="row row-cards">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title mb-0">@Localizer["DocumentTypeEditHeading"]</h3>
      </div>

      <div class="card-body">
        <div class="alert alert-info mb-4" role="alert">
          <div class="d-flex">
            <div class="me-3">
              <i class="ri-information-line fs-3 text-info"></i>
            </div>
            <div>
              <div class="fw-semibold">@Localizer["DocumentTypeEditHeading"]</div>
              <div class="text-secondary">@Localizer["DocumentTypeExplanation"]</div>
            </div>
          </div>
        </div>

        <form method="post" action="/Company/Payment_DocumentTypes/Edit">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="DocumentTypeID" />
          <input type="hidden" asp-for="TenantID" />

          <div class="mb-3">
            <label class="form-label" for="DocumentTypeName">@Localizer["DocumentTypeName"]</label>
            <input class="form-control" asp-for="DocumentTypeName" placeholder="@Localizer["EnterDocumentTypeName"]" aria-label="@Localizer["DocumentTypeName"]" />
            <span class="text-danger" asp-validation-for="DocumentTypeName"></span>
          </div>

          <div class="mb-3">
            <label class="form-label" for="DocumentTypeDescription">@Localizer["DocumentTypeDescription"]</label>
            <input class="form-control" asp-for="DocumentTypeDescription" placeholder="@Localizer["EnterDocumentTypeDescription"]" aria-label="@Localizer["DocumentTypeDescription"]" />
            <span class="text-danger" asp-validation-for="DocumentTypeDescription"></span>
          </div>

          <div class="mt-4 btn-list">
            <button type="submit" class="btn btn-primary">
              <i class="ri-save-line me-1"></i>@SharedLocalizer["Save"]
            </button>
            <a class="btn btn-outline-secondary" href="/Company/Payment_DocumentTypes">
              @SharedLocalizer["Cancel"]
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
