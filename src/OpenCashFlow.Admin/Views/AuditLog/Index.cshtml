@model OpenCashFlow.Admin.Models.AuditLog.AuditLogIndexViewModel
@{
    ViewData["Title"] = "Audit Log";
    var filters = Model.Filters;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Audit Log</h1>
            <p class="text-muted">Monitor critical operations performed by administrators.</p>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <input type="hidden" name="Page" value="1" />
                <input type="hidden" name="SortBy" value="@filters.SortBy" />
                <input type="hidden" name="SortDescending" value="@filters.SortDescending" />

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Search</label>
                    <input type="text" name="Search" class="form-control" value="@filters.Search" placeholder="Action, username, details..." />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Event</label>
                    <select class="form-select" name="EventType">
                        <option value="">All</option>
                        @foreach (var eventType in Model.EventTypes)
                        {
                            <option value="@eventType" selected="@(filters.EventType == eventType)">
                                @eventType
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Resource</label>
                    <input type="text" name="Resource" class="form-control" value="@filters.Resource" placeholder="Company, User, Billing..." />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Severity</label>
                    <select class="form-select" name="Severity">
                        <option value="">All</option>
                        @foreach (var severity in Model.Severities)
                        {
                            <option value="@severity" selected="@(filters.Severity == severity)">@severity</option>
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">User (GUID)</label>
                    <input type="text" name="UserID" class="form-control" value="@(filters.UserID?.ToString())" placeholder="User ID" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Company (GUID)</label>
                    <input type="text" name="TenantID" class="form-control" value="@(filters.TenantID?.ToString())" placeholder="Company ID" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">IP Address</label>
                    <input type="text" name="IPAddress" class="form-control" value="@filters.IPAddress" placeholder="e.g., 192.168.0.1" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Date from</label>
                    <input type="datetime-local" name="TimestampFrom" class="form-control" value="@(filters.TimestampFrom?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Date to</label>
                    <input type="datetime-local" name="TimestampTo" class="form-control" value="@(filters.TimestampTo?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" />
                </div>

                <div class="col-lg-2 col-md-4">
                    <label class="form-label">Page size</label>
                    <select class="form-select" name="PageSize">
                        @{ var pageSizes = new[] { 25, 50, 100, 200 }; }
                        @foreach (var size in pageSizes)
                        {
                            <option value="@size" selected="@(filters.PageSize == size)">@size</option>
                        }
                    </select>
                </div>

                <div class="col-lg-4 col-md-8 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-search-2-line me-1"></i> Apply filters
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="ri-refresh-line me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="text-muted">
            Total logs: <strong>@Model.TotalCount</strong>
        </div>
        <form method="get" asp-action="Export" class="d-inline-flex gap-2 align-items-center">
            <input type="hidden" name="Search" value="@filters.Search" />
            <input type="hidden" name="EventType" value="@filters.EventType" />
            <input type="hidden" name="Resource" value="@filters.Resource" />
            <input type="hidden" name="UserID" value="@(filters.UserID?.ToString())" />
            <input type="hidden" name="TenantID" value="@(filters.TenantID?.ToString())" />
            <input type="hidden" name="IPAddress" value="@filters.IPAddress" />
            <input type="hidden" name="Severity" value="@filters.Severity" />
            <input type="hidden" name="TimestampFrom" value="@(filters.TimestampFrom?.ToString("O"))" />
            <input type="hidden" name="TimestampTo" value="@(filters.TimestampTo?.ToString("O"))" />
            <input type="hidden" name="Page" value="@filters.Page" />
            <input type="hidden" name="PageSize" value="@filters.PageSize" />
            <input type="hidden" name="SortBy" value="@filters.SortBy" />
            <input type="hidden" name="SortDescending" value="@filters.SortDescending" />
            <button type="submit" class="btn btn-outline-primary">
                <i class="ri-download-line me-1"></i> Export CSV
            </button>
        </form>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Event</th>
                            <th>Resource</th>
                            <th>Action</th>
                            <th>User</th>
                            <th>IP</th>
                            <th>Severity</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs == null || Model.Logs.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    No logs found with the current filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td>@log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        <span class="badge bg-label-primary">@log.EventType</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@log.Resource</div>
                                        <div class="text-muted small">@log.ResourceID</div>
                                    </td>
                                    <td>@log.Action</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(log.Username))
                                        {
                                            <span>@log.Username</span>
                                        }
                                        else if (log.UserID.HasValue)
                                        {
                                            <span class="text-muted small">@log.UserID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">System</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(log.IPAddress) ? "-" : log.IPAddress)</td>
                                    <td>
                                        @{
                                            var severity = log.Severity ?? "Info";
                                            var badgeClass = severity switch
                                            {
                                                "Critical" => "bg-danger",
                                                "Error" => "bg-danger",
                                                "Warning" => "bg-warning text-dark",
                                                _ => "bg-success"
                                            };
                                        }
                                        <span class="badge @badgeClass">@severity</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@log.AuditLogID" class="btn btn-sm btn-icon btn-outline-primary" title="Details">
                                            <i class="ri-eye-line"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-Page="@i"
                                   asp-route-PageSize="@filters.PageSize"
                                   asp-route-Search="@filters.Search"
                                   asp-route-EventType="@filters.EventType"
                                   asp-route-Resource="@filters.Resource"
                                   asp-route-UserID="@(filters.UserID?.ToString())"
                                   asp-route-TenantID="@(filters.TenantID?.ToString())"
                                   asp-route-IPAddress="@filters.IPAddress"
                                   asp-route-Severity="@filters.Severity"
                                   asp-route-TimestampFrom="@(filters.TimestampFrom?.ToString("O"))"
                                   asp-route-TimestampTo="@(filters.TimestampTo?.ToString("O"))"
                                   asp-route-SortBy="@filters.SortBy"
                                   asp-route-SortDescending="@filters.SortDescending">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
