{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Identity": "Debug",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "SecretKey": "CHANGE_ME_WITH_A_RANDOM_64_CHAR_SECRET_FOR_SELF_HOSTED_SETUP",
    "Issuer": "https://api3.opencashflow.local",
    "Audience": "https://beta.opencashflow.local"
  },

  "Account": {
    "CookieDomain": ".opencashflow.local",
    "SessionCookieDomain": ".opencashflow.local",
    "API": "https://api3.opencashflow.local",
    "Login": "https://beta.opencashflow.local/Login",
    "FastLogin": "https://beta.opencashflow.local/FastLogin",
    "Logout": "https://beta.opencashflow.local/Account/Logout",
    "AppUrl": "https://beta.opencashflow.local/"
  },

  "Sentry": {
    "Dsn": "https://YOUR_DSN_HERE",
    "TracesSampleRate": 0.5,
    "Environment": "Staging"
  }
}
