@using Shared.DTOs.Companies
@model Company_Invoices_Detail_DTO

@{
	ViewData["Title"] = Localizer["InvoicePreviewTitle"].Value;
}

@section VendorStyles {
<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css">
}

@section VendorScripts {
<script src="~/vendor/libs/moment/moment.js"></script>
<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="~/vendor/libs/cleavejs/cleave.js"></script>
<script src="~/vendor/libs/cleavejs/cleave-phone.js"></script>
}

@section PageStyles {
<link rel="stylesheet" href="~/vendor/css/pages/app-invoice.css" />
}

@section PageScripts {
<script src="~/js/offcanvas-add-payment.js"></script>
<script src="~/js/offcanvas-send-invoice.js"></script>
}

@* ************** Content ************** *@
<div class="row invoice-preview">
	<!-- Invoice -->
	<div class="col-xl-9 col-md-8 col-12 mb-md-0 mb-6">
		<div class="card invoice-preview-card p-sm-12 p-6">
			<div class="card-body invoice-preview-header rounded-4 p-6">
				<div class="d-flex justify-content-between flex-xl-row flex-md-column flex-sm-row flex-column text-heading align-items-xl-center align-items-md-start align-items-sm-center flex-wrap gap-6">
					<div>
						<div class="d-flex svg-illustration align-items-center gap-2 mb-6">
							<span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
							<span class="mb-0 app-brand-text fw-semibold demo">@TempData.Peek("appName")</span>
						</div>
							<p class="mb-1">@Localizer["CompanyAddressLine1"]</p>
							<p class="mb-1">@Localizer["CompanyAddressLine2"]</p>
							<p class="mb-0">@Localizer["CompanyPhone"]</p>
					</div>
					<div>
						<h5 class="mb-6">@Localizer["Invoice"] #@Model.InvoiceNumber</h5>
						<div class="mb-1">
							<span>@Localizer["Date Issues:"]</span>
							<span>@Model.IssueDate.ToShortDateString()</span>
						</div>
						<div>
							<span>@Localizer["Date Paid"]:</span>
							<span>@Model.PaymentDate?.ToShortDateString()</span>
						</div>
					</div>
				</div>
			</div>
			<div class="card-body py-6 px-0">
				<div class="d-flex justify-content-between flex-wrap gap-6">
					<div>
						<h6>@Localizer["Invoice To:"]</h6>
						<p class="mb-1">@Model.CompanyName - @Localizer["VAT:"] @Model.TaxIdentificationNumber</p>
						<p class="mb-1">@Model.BillingAddressLine1, @Model.BillingAddressLine2, @Model.BillingCity </p>
						<p class="mb-1">@Model.BillingPostalCode @Model.BillingState, @Model.BillingCountry</p>
						<p class="mb-1">@Model.ContactPhone - @Model.ContactEmail</p>
					</div>
					<div>
						<h6>@Localizer["Bill To:"]</h6>
						<table>
							<tbody>
								<tr>
									<td class="pe-4">@Localizer["Total Due:"]</td>
									<td>&euro; @Model.TotalAmount</td>
								</tr>
								<tr>
									<td class="pe-4">@Localizer["Payment Method"]</td>
									<td>@Model.PaymentMethod</td>
								</tr>

							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div class="table-responsive border rounded-4 border-bottom-0">
				<table class="table m-0">
					<thead>
						<tr>
							<th>@Localizer["Description"]</th>
							<th>@Localizer["Cost"]</th>
							<th>@Localizer["Qty"]</th>
							<th>@Localizer["Price"]</th>
						</tr>
					</thead>
					<tbody>
						@{
							if(Model.Items != null)
							{
								foreach (Company_Invoice_Item item in Model.Items)
								{
									<tr>
										<td class="text-nowrap text-heading">@item.Description</td>
										<td>&euro;@item.UnitPrice</td>
										<td>@item.Quantity</td>
										<td>&euro;@item.Subtotal</td>
									</tr>
								}
							}
						}						
					</tbody>
				</table>
			</div>
			<div class="table-responsive">
				<table class="table m-0 table-borderless">
					<tbody>
						<tr>
							<td class="align-top px-0 py-6">
								<p class="mb-1">
									<span class="me-2 fw-medium text-heading">@Localizer["Salesperson:"]</span>
									<span>@Localizer["SalespersonNamePlaceholder"]</span>
								</p>
								<span></span>
							</td>
							<td class="pe-0 py-6 w-px-100">
								<p class="mb-1">@Localizer["Subtotal:"]</p>
								<p class="mb-1 border-bottom pb-2">@Localizer["Tax:"]</p>
								<p class="mb-0 pt-2">@Localizer["Total:"]</p>
							</td>
							<td class="text-end px-0 py-6 w-px-100">
								<p class="fw-medium mb-1">&euro;@(Model.TotalAmount - Model.TotalTaxes)</p>
								<p class="fw-medium mb-1 border-bottom pb-2">&euro;@Model.TotalTaxes</p>
								<p class="fw-medium mb-0 pt-2">&euro;@Model.TotalAmount</p>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<hr class="mt-0 mb-6">
			<div class="card-body p-0">
				<div class="row">
					<div class="col-12">
						<span class="fw-medium text-heading">@Localizer["Note:"]</span>
						<span>@Model.Notes</span>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- /Invoice -->
	<!-- Invoice Actions -->
	<div class="col-xl-3 col-md-4 col-12 invoice-actions">
		<div class="card">
			<div class="card-body">
				<button class="btn btn-primary d-grid w-100 mb-4">
					<span class="d-flex align-items-center justify-content-center text-nowrap">
							<i class="ri-download-2-line ri-16px scaleX-n1-rtl me-2"></i>@Localizer["DownloadButton"]
					</span>
				</button>
				<a class="btn btn-outline-secondary d-grid w-100 me-4" target="_blank"
				   href="~/Company/Invoices/View/@Model.InvoiceID/Print">
					<span class="d-flex align-items-center justify-content-center text-nowrap">
							<i class="ri-printer-line ri-16px scaleX-n1-rtl me-2"></i>@Localizer["PrintButton"]
					</span>
				</a>

			</div>
		</div>
	</div>
	<!-- /Invoice Actions -->
</div>
