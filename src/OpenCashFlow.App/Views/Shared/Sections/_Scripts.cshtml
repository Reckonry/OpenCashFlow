@using Shared.Core
@inject IConfiguration _configuration
<environment include="Development">
    <script src="~/js/tabler.js"></script>
</environment>
<environment exclude="Development">
    <script src="~/js/tabler.min.js" asp-append-version="true"></script>
</environment>

@if (User?.Identity?.IsAuthenticated ?? false)
{
    <script>
        (function() {
            const redirectUrl = '@Url.Content("~/Account/Disconnect")';
            const authInfoCookieName = "@(Configuration.AuthCookieName).Info";
            const checkIntervalMs = 30 * 1000;
            let expirationTimeoutId = null;
            let checkIntervalId = null;
            let hadToken = false;

            function getCookie(name) {
                const value = "; " + document.cookie;
                const parts = value.split("; " + name + "=");
                if (parts.length === 2) return parts.pop().split(";").shift();
                return null;
            }

            function goToLogin() {
                const targetUrl = redirectUrl;
                if (window.top && window.top !== window.self) {
                    window.top.location.href = targetUrl;
                } else {
                    window.location.replace(targetUrl);
                }
            }

            function checkTokenExpiry() {
                const expirationTimestamp = getCookie(authInfoCookieName);

                if (!expirationTimestamp) {
                    if (hadToken) {
                        goToLogin();
                    }
                    return;
                }

                hadToken = true;
                const expirationTime = parseInt(expirationTimestamp, 10);
                const now = Math.floor(Date.now() / 1000);
                const secondsRemaining = expirationTime - now;

                if (secondsRemaining <= 0) {
                    goToLogin();
                    return;
                }

                // Schedule exact disconnect time
                if (expirationTimeoutId !== null) {
                    clearTimeout(expirationTimeoutId);
                }

                const msUntilExpiry = secondsRemaining * 1000;
                expirationTimeoutId = setTimeout(goToLogin, msUntilExpiry);
            }

            // Initial check
            checkTokenExpiry();

            // Periodic checks to detect cookie updates from refresh
            checkIntervalId = setInterval(checkTokenExpiry, checkIntervalMs);

            // Cleanup on unload
            window.addEventListener('beforeunload', () => {
                if (checkIntervalId) clearInterval(checkIntervalId);
                if (expirationTimeoutId) clearTimeout(expirationTimeoutId);
            });
        })();
    </script>
    <script>
        (function() {
            const inactivityMinutes = @(Configuration.WebSessionDurationMinutes);
            const inactivityMs = inactivityMinutes * 60 * 1000;
            const refreshThresholdSeconds = 480;
            const refreshCheckIntervalMs = 120 * 1000;
            const minRefreshIntervalMs = 90 * 1000;
            const authInfoCookieName = "@(Configuration.AuthCookieName).Info";
            const apiBaseUrl = '@_configuration["Account:API"]';
            const refreshUrl = `${apiBaseUrl}/v1/Authentication/refresh`;

            let inactivityTimeoutId;
            let refreshCheckIntervalId;
            let lastRefreshTime = 0;
            let lastActivityTime = Date.now();
            let isRefreshing = false;

            function getCookie(name) {
                const value = "; " + document.cookie;
                const parts = value.split("; " + name + "=");
                if (parts.length === 2) return parts.pop().split(";").shift();
                return null;
            }

            async function refreshTokenIfNeeded() {
                const now = Date.now();
                if (now - lastRefreshTime < minRefreshIntervalMs || isRefreshing) {
                    return;
                }

                const expirationTimestamp = getCookie(authInfoCookieName);
                if (!expirationTimestamp) {
                    return;
                }

                const expirationTime = parseInt(expirationTimestamp, 10);
                const currentTime = Math.floor(now / 1000);
                const secondsRemaining = expirationTime - currentTime;

                // Refresh only if we're below the threshold and the user is active
                if (secondsRemaining <= refreshThresholdSeconds && secondsRemaining > 0) {
                    const timeSinceActivity = now - lastActivityTime;
                    if (timeSinceActivity > refreshCheckIntervalMs) {
                        return;
                    }

                    isRefreshing = true;
                    lastRefreshTime = now;

                    try {
                        const response = await fetch(refreshUrl, {
                            method: 'POST',
                            credentials: 'include'
                        });

                        if (!response.ok) {
                            console.error('[RefreshToken] Refresh failed:', response.status);
                        }
                    } catch (error) {
                        console.error('[RefreshToken] Error:', error);
                    } finally {
                        isRefreshing = false;
                    }
                }
            }

            function recordActivity() {
                lastActivityTime = Date.now();
            }

            function resetInactivityTimer() {
                if (inactivityTimeoutId) {
                    clearTimeout(inactivityTimeoutId);
                }

                recordActivity();

                inactivityTimeoutId = setTimeout(() => {
                    const redirectUrl = '@Url.Content("~/Account/Disconnect")';
                    if (window.top && window.top !== window.self) {
                        window.top.location.href = redirectUrl;
                    } else {
                        window.location.replace(redirectUrl);
                    }
                }, inactivityMs);
            }

            // Events to track user activity
            const activityEvents = ['click', 'keydown', 'touchstart', 'mousemove', 'scroll'];
            activityEvents.forEach(evt => {
                document.addEventListener(evt, resetInactivityTimer, true);
            });

            // Automatic refresh timer
            refreshCheckIntervalId = setInterval(refreshTokenIfNeeded, refreshCheckIntervalMs);

            // Initialize
            resetInactivityTimer();
        })();
    </script>
}
