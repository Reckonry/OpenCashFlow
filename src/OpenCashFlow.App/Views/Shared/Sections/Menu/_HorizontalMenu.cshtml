@{
    TempData.Keep();
    string? currentPage = ViewContext.HttpContext.Request.Path;
    ViewData["containerNav"] ??= "container-xl";
}

<div class="navbar-expand-md">
    <div class="collapse navbar-collapse" id="navbar-menu">
        <div class="navbar">
            <div class='@ViewData["containerNav"]'>
                <div class="row flex-column flex-md-row flex-fill align-items-center">
                    <div class="col">
                        <nav aria-label="Primary">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class='nav-link@(currentPage == "/" || currentPage?.StartsWith("/Dashboards") == true ? " active" : "")' href="/">
                                        <span class="nav-link-title">@Localizer["Dashboards"]</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class='nav-link@(currentPage?.StartsWith("/Payments") == true ? " active" : "")' href="~/Payments">
                                        <span class="nav-link-title">Incassi</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class='nav-link@(currentPage?.StartsWith("/Payments/Calendar") == true ? " active" : "")' href="~/Payments/Calendar">
                                        <span class="nav-link-title">Calendario Incassi</span>
                                    </a>
                                </li>
                                @if (User.Claims.Any(c => c.Type == System.Security.Claims.ClaimTypes.Role && c.Value == "Administrator"))
                                {
                                    <li class="nav-item">
                                        <a class='nav-link@(currentPage?.StartsWith("/Company") == true ? " active" : "")' href="~/Company">
                                            <span class="nav-link-title">Azienda</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class='nav-link@(currentPage?.StartsWith("/Employees") == true ? " active" : "")' href="~/Employees">
                                            <span class="nav-link-title">Dipendenti</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                    <div class="col col-md-auto ms-md-auto">
                        <nav aria-label="Secondary">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link" href='@TempData.Peek("support")' target="_blank">
                                        <span class="nav-link-title">Support</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href='@TempData.Peek("documentation")' target="_blank">
                                        <span class="nav-link-title">Documentation</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
