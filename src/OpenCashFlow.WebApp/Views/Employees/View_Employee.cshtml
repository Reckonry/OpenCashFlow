@using System.Security.Claims;
@using OpenCashFlow.Contracts.DTOs.Employees
@model Employee_Detail_DTO

@{
    ViewData["Title"] = Localizer["EmployeeDetailsTitle"].Value;
}
@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
}

@section VendorScripts {
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-profile.dist.css" />
}

@section PageScripts {
    <script src="~/js/pages-profile.dist.js"></script>

}


@await Html.PartialAsync("Components/_ViewHeader", Model, ViewData)

@Html.Raw(ViewBag.ResponseMessage)

@* Page header (Tabler style) *@
<div class="page-header d-print-none mb-4">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">@Localizer["Employee"]</h2>
      <div class="text-secondary mt-1">@Localizer["EmployeeDetailsTitle"]</div>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="btn-list">
        <a href="~/Employees" class="btn btn-outline-secondary">
          <i class="ri-arrow-go-back-fill"></i>
          <span class="d-none d-sm-inline ms-1">@Localizer["Back"]</span>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="row row-cards">

  @* Left column *@
  <div class="col-12 col-md-5 col-xl-4">
    <div class="card">
      <div class="card-body">
        @await Html.PartialAsync("Components/_EmployeeDetails", Model, ViewData)
      </div>
    </div>

