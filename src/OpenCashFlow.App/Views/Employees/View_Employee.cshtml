        <div class="card mb-6">
            <div class="card-body">
                <h5 class="mb-6">@Localizer["Password Reset"]</h5>
                <p class="mb-4">@Localizer["PasswordResetSubTitle"]</p>
                <p class="w-75">
                    @Localizer["PasswordResetDescription"]
                    <a href="javascript:void(0);">Learn more.</a>
                </p>
                <form asp-controller="Authentication"
                      asp-action="SendPasswordReset" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@Model.UserID" />
                    <button type="submit" class="btn btn-primary mt-2 waves-effect waves-light">
                        @Localizer["Send password reset E-Mail"]
                    </button>
                </form>
            </div>
        </div>
