@model Payment_Method_Update_DTO
@{
    ViewData["Title"] = Localizer["PaymentMethodEditTitle"].Value;
}

@await Html.PartialAsync("Components/_Company_ViewHeader", ViewData)

<div class="card">
  <h5 class="card-header">@Localizer["PaymentMethodEditHeading"]</h5>
  <div class="card-body">
    <div class="alert alert-info mb-3">
      <i class="ri-information-line me-2"></i>@Localizer["PaymentMethodExplanation"]
    </div>
    <form method="post" asp-controller="Company" asp-action="Company_Payment_Method_Edit">
      <input type="hidden" asp-for="PaymentMethodID" />
      <input type="hidden" asp-for="TenantID" />
      <div class="mb-3">
        <label class="form-label" for="PaymentMethodName">@Localizer["PaymentMethodName"]</label>
        <input class="form-control" asp-for="PaymentMethodName" placeholder="@Localizer["EnterPaymentMethodName"]" aria-label="@Localizer["PaymentMethodName"]" />
        <span class="text-danger" asp-validation-for="PaymentMethodName"></span>
      </div>
      <div class="mb-3">
        <label class="form-label" for="PaymentMethodDescription">@Localizer["PaymentMethodDescription"]</label>
        <input class="form-control" asp-for="PaymentMethodDescription" placeholder="@Localizer["EnterPaymentMethodDescription"]" aria-label="@Localizer["PaymentMethodDescription"]" />
        <span class="text-danger" asp-validation-for="PaymentMethodDescription"></span>
      </div>
      <div class="mt-3">
        <button type="submit" class="btn btn-primary">@SharedLocalizer["Save"]</button>
        <a class="btn btn-secondary" href="/Company/Payment_Methods">@SharedLocalizer["Cancel"]</a>
      </div>
    </form>
  </div>
</div>
