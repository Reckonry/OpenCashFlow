    @* (legacy Vuexy markup preserved below) *@

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">@Localizer["Password Reset"]</h3>
      </div>
      <div class="card-body">
        <p class="text-secondary mb-3">@Localizer["PasswordResetSubTitle"]</p>
        <p class="mb-3">
          @Localizer["PasswordResetDescription"]
          <a href="javascript:void(0);">Learn more.</a>
        </p>

        <form asp-controller="Authentication" asp-action="SendPasswordReset" method="post" class="d-inline">
          @Html.AntiForgeryToken()
          <input type="hidden" name="userId" value="@Model.UserID" />
          <button type="submit" class="btn btn-primary">
            @Localizer["Send password reset E-Mail"]
