{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Identity": "Debug",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnectionString": "Host=localhost;Database=opencashflow_db;Username=opencashflow;Password=A_SECURE_PASSWORD_HERE!;"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_WITH_A_RANDOM_64_CHAR_SECRET_FOR_SELF_HOSTED_SETUP",
    "Issuer": "https://api3.opencashflow.local",
    "Audience": "https://beta.opencashflow.local"
  },
  "AllowedHosts": "*",

  "AppUrl": "https://beta.opencashflow.local/",

  "Account": {
    "CookieDomain": ".opencashflow.local"
  },

  "Cors": {
    "AllowedOrigins": [
      "https://beta.opencashflow.local",
      "https://admin3.opencashflow.local",
      "https://management3.opencashflow.local"
    ],
    "AllowCredentials": true
  },

  "Sentry": {
    "Dsn": "https://YOUR_DSN_HERE",
    "TracesSampleRate": 0.5,
    "Environment": "Staging"
  },

  "EmailConfiguration": {
    "From": "noreply@opencashflow.local",
    "FromName": "OpenCashFlow",
    "SmtpServer": "smtps.opencashflow.local",
    "Port": 465,
    "Username": "noreply@opencashflow.local",
    "Password": "set-via-env"
  },
  "Security": {
    "SessionMinutes": 15,
    "PasswordResetTokenMinutes": 30,
    "FastLogin": {
      "Enabled": false,
      "MaxAttempts": 5,
      "LockoutMinutes": 15,
      "PinRotationDays": 90
    }
  }
}
