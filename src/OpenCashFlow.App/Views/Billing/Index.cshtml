@model Shared.DTOs.Billing.BillingPortal_DTO
@using Shared.Models
@{
    ViewData["Title"] = "Billing and Subscription";
}

@section PageStyles {
    <style>
        .billing-card {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            background: white;
        }
        .billing-card h5 {
            margin-bottom: 1rem;
            font-weight: 600;
        }
        .payment-failed-banner {
            background: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 1rem;
            margin-bottom: 1.5rem;
            border-radius: 4px;
        }
        .plan-badge {
            font-size: 0.875rem;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
        }
        .invoice-row:hover {
            background-color: #f8f9fa;
        }
    </style>
}

@* Success/Error Messages *@
@if (ViewData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ri-checkbox-circle-line me-2"></i>@ViewData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ri-error-warning-line me-2"></i>@ViewData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Payment Failed Banner *@
@if (Model.HasPaymentFailed)
{
    <div class="payment-failed-banner">
        <div class="d-flex align-items-center">
            <i class="ri-alert-line fs-3 text-warning me-3"></i>
            <div class="flex-grow-1">
                <h6 class="mb-1"><strong>Warning: Payment Failed</strong></h6>
                <p class="mb-2">@Model.PaymentFailureReason</p>
                @if (Model.HasStripeIntegration)
                {
                    <form asp-action="OpenCustomerPortal" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Billing")" />
                        <button type="submit" class="btn btn-warning btn-sm">
                            <i class="ri-bank-card-line me-1"></i> Update Payment Method
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
}

@if (Model.SubscriptionID.HasValue)
{
    <!-- Current Subscription Summary -->
    <div class="billing-card">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h5><i class="ri-vip-crown-line text-primary"></i> Your Subscription</h5>
                <h3 class="mb-1">@Model.PlanName</h3>
                @if (!string.IsNullOrEmpty(Model.PlanDescription))
                {
                    <p class="text-muted">@Model.PlanDescription</p>
                }
            </div>
            <div class="text-end">
                <h4 class="mb-0">€@Model.Cost.ToString("N2")</h4>
                <small class="text-muted">/@(Model.BillingCycle == BillingCycle.MONTHLY ? "month" : "year")</small>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-4">
                <strong>Status:</strong>
                @if (Model.RenewalStatus == RenewalStatus.ACTIVE)
                {
                    <span class="badge bg-success plan-badge">Active</span>
                }
                else if (Model.RenewalStatus == RenewalStatus.TRIAL)
                {
                    <span class="badge bg-info plan-badge">Trial</span>
                }
                else if (Model.RenewalStatus == RenewalStatus.PAUSED)
                {
                    <span class="badge bg-warning plan-badge">Paused</span>
                }
                else if (Model.RenewalStatus == RenewalStatus.CANCELLED)
                {
                    <span class="badge bg-danger plan-badge">Canceled</span>
                }
                else
                {
                    <span class="badge bg-secondary plan-badge">@Model.RenewalStatus</span>
                }
            </div>
            <div class="col-md-4">
                <strong>Next Renewal:</strong>
                <div>@Model.NextBillingDate?.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-md-4">
                <strong>Expiration:</strong>
                <div>@Model.EndDate?.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        @if (Model.Discount.HasValue && Model.Discount.Value > 0)
        {
            <div class="alert alert-success mt-3 mb-0">
                <i class="ri-percent-line"></i> <strong>Active Discount:</strong> @Model.Discount.Value% discount
                @if (!string.IsNullOrEmpty(Model.PromoCode))
                {
                    <text> with code <code>@Model.PromoCode</code></text>
                }
            </div>
        }
    </div>

    @* Manage Payments Button (Stripe Customer Portal) *@
    @if (Model.HasStripeIntegration)
    {
        <div class="billing-card">
            <h5><i class="ri-bank-card-2-line"></i> Manage Payment Methods</h5>
            <p class="text-muted">Update your cards, view invoices, and manage your subscription through the secure Stripe portal.</p>
            <form asp-action="OpenCustomerPortal" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Billing")" />
                <button type="submit" class="btn btn-primary">
                    <i class="ri-external-link-line me-1"></i> Open Payments Portal
                </button>
            </form>
        </div>

    }

    @* Upcoming Invoice *@
    @if (Model.UpcomingInvoice != null)
    {
        <div class="billing-card">
            <h5><i class="ri-bill-line"></i> Upcoming Invoice</h5>
            <div class="row">
                <div class="col-md-6">
                    <strong>Estimated Amount:</strong>
                    <h4 class="text-primary">€@Model.UpcomingInvoice.AmountDue.ToString("N2")</h4>
                </div>
                <div class="col-md-6">
                    <strong>Billing Period:</strong>
                    <div>
                        @Model.UpcomingInvoice.CreatedUtc?.ToString("dd/MM/yyyy") -
                        @Model.UpcomingInvoice.DueDateUtc?.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        </div>
    }

    @* Invoices History *@
    @if (Model.RecentInvoices.Any())
    {
        <div class="billing-card">
            <h5><i class="ri-file-list-line"></i> Invoice History</h5>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Number</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model.RecentInvoices.OrderByDescending(i => i.Date))
                        {
                            <tr class="invoice-row">
                                <td>@invoice.Date.ToString("dd/MM/yyyy")</td>
                                <td><code>@invoice.InvoiceNumber</code></td>
                                <td><strong>€@invoice.Amount.ToString("N2")</strong></td>
                                <td>
                                    @if (invoice.IsPaid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (invoice.Status == "open")
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else if (invoice.Status == "void")
                                    {
                                        <span class="badge bg-secondary">Canceled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@invoice.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(invoice.PdfUrl))
                                    {
                                        <a href="@invoice.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="ri-download-line"></i> PDF
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Upgrade/Downgrade Modal *@
    @if (Model.AvailablePlans.Any())
    {
        <div class="billing-card">
            <h5><i class="ri-refresh-line"></i> Change Plan</h5>
            <p class="text-muted">Choose a plan that fits your needs.</p>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#changePlanModal">
                <i class="ri-arrow-left-right-line me-1"></i> Change Plan
            </button>
        </div>

        <!-- Change Plan Modal -->
        <div class="modal fade" id="changePlanModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Change Subscription Plan</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">Select the new plan you want to activate. The change will take effect immediately.</p>
                        <div class="row g-3">
                            @foreach (var plan in Model.AvailablePlans.Where(p => p.PlanID != Model.SubscriptionID))
                            {
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">@plan.Name</h5>
                                            <p class="card-text text-muted small">@plan.Description</p>
                                            <h4 class="text-primary">€@plan.Price.ToString("N2")</h4>
                                            <small class="text-muted">/@(plan.BillingCycle == BillingCycle.MONTHLY ? "month" : "year")</small>
                                            <form asp-action="ChangePlan" method="post" class="mt-3">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="subscriptionId" value="@Model.SubscriptionID" />
                                                <input type="hidden" name="newPlanId" value="@plan.PlanID" />
                                                <button type="submit" class="btn btn-primary w-100">
                                                    Select Plan
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- No Active Subscription -->
    <div class="billing-card text-center py-5">
        <i class="ri-vip-crown-line display-1 text-muted"></i>
        <h4 class="mt-3">No Active Subscription</h4>
        <p class="text-muted">You don't have an active subscription yet. Contact the administrator to activate your plan.</p>
        @if (Model.AvailablePlans.Any())
        {
            <h5 class="mt-4 mb-3">Available Plans</h5>
            <div class="row g-3 justify-content-center">
                @foreach (var plan in Model.AvailablePlans.Take(3))
                {
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5>@plan.Name</h5>
                                <h4 class="text-primary">€@plan.Price.ToString("N2")</h4>
                                <small class="text-muted">/@(plan.BillingCycle == BillingCycle.MONTHLY ? "month" : "year")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}
