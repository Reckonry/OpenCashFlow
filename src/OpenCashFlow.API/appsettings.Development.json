{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnectionString": "Host=localhost;Database=opencashflow_db;Username=postgres;Password=postgres;"
  },

  "JwtSettings": {
    "SecretKey": "CHANGE_ME_WITH_A_RANDOM_64_CHAR_SECRET_FOR_SELF_HOSTED_SETUP",
    "Issuer": "https://localhost:9001",
    "Audience": [
      "https://localhost:3001",
      "https://localhost:6001",
      "https://localhost:7001",
      "https://localhost:9006"
    ]
  },

  "AppUrl": "https://localhost:7001/",

  "Account": {
    "CookieDomain": ".localhost"
  },

  "Cors": {
    "AllowedOrigins": ["https://localhost:7001", "https://localhost:9005"],
    "AllowCredentials": true
  },

  "EmailConfiguration": {
    "From": "noreply@opencashflow.local",
    "FromName": "OpenCashFlow",
    "SmtpServer": "smtp.local",
    "Port": 587,
    "UserName": "test@OpenCashFlow.local",
    "Password": "set-via-env",
    "Security": "STARTTLS"
  },
  "Security": {
    "SessionMinutes": 15,
    "PasswordResetTokenMinutes": 30,
    "FastLogin": {
      "Enabled": false,
      "MaxAttempts": 5,
      "LockoutMinutes": 15,
      "PinRotationDays": 90
    }
  }
}
