@model Shared.DTOs.Billing.BillingPortal_DTO
@using Shared.Models
@{
    ViewData["Title"] = "Billing and Subscription";
}

@section PageStyles {
    <style>
        .invoice-row:hover { background-color: rgba(0,0,0,.02); }
    </style>
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Billing &amp; Subscription</h2>
            <div class="text-secondary mt-1">Manage your plan, invoices, and payment methods</div>
        </div>
    </div>
</div>

@* Success/Error Messages *@
@if (ViewData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ri-checkbox-circle-line me-2"></i>@ViewData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ri-error-warning-line me-2"></i>@ViewData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Payment Failed Banner *@
@if (Model.HasPaymentFailed)
{
    <div class="alert alert-warning" role="alert">
        <div class="d-flex">
            <div class="me-3">
                <i class="ri-alert-line fs-3 text-warning"></i>
            </div>
            <div class="flex-grow-1">
                <h4 class="alert-title mb-1"><strong>Warning: Payment Failed</strong></h4>
                <div class="text-secondary mb-2">@Model.PaymentFailureReason</div>
                @if (Model.HasStripeIntegration)
                {
                    <form asp-action="OpenCustomerPortal" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Billing")" />
                        <button type="submit" class="btn btn-warning btn-sm">
                            <i class="ri-bank-card-line me-1"></i> Update Payment Method
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
}

@if (Model.SubscriptionID.HasValue)
{
    <!-- Current Subscription Summary -->
    <div class="card mb-4">
        <div class="card-header">
            <h3 class="card-title mb-0"><i class="ri-vip-crown-line text-primary me-2"></i> Your Subscription</h3>
        </div>
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                <div>
                    <div class="h2 mb-1">@Model.PlanName</div>
                    @if (!string.IsNullOrEmpty(Model.PlanDescription))
                    {
                        <div class="text-secondary">@Model.PlanDescription</div>
                    }
                </div>

                <div class="text-end">
                    <div class="h2 mb-0">€@Model.Cost.ToString("N2")</div>
                    <div class="text-secondary small">/@(Model.BillingCycle == BillingCycle.MONTHLY ? "month" : "year")</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="text-secondary small">Status</div>
                    <div>
                        @if (Model.RenewalStatus == RenewalStatus.ACTIVE)
                        {
                            <span class="badge bg-green-lt">Active</span>
                        }
                        else if (Model.RenewalStatus == RenewalStatus.TRIAL)
                        {
                            <span class="badge bg-azure-lt">Trial</span>
                        }
                        else if (Model.RenewalStatus == RenewalStatus.PAUSED)
                        {
                            <span class="badge bg-yellow-lt">Paused</span>
                        }
                        else if (Model.RenewalStatus == RenewalStatus.CANCELLED)
                        {
                            <span class="badge bg-red-lt">Canceled</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">@Model.RenewalStatus</span>
                        }
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="text-secondary small">Next Renewal</div>
                    <div class="fw-semibold">@Model.NextBillingDate?.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="text-secondary small">Expiration</div>
                    <div class="fw-semibold">@Model.EndDate?.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            @if (Model.Discount.HasValue && Model.Discount.Value > 0)
            {
                <div class="alert alert-success mt-3 mb-0" role="alert">
                    <i class="ri-percent-line me-1"></i>
                    <strong>Active Discount:</strong> @Model.Discount.Value% discount
                    @if (!string.IsNullOrEmpty(Model.PromoCode))
                    {
                        <text> with code <code>@Model.PromoCode</code></text>
                    }
                </div>
            }

        </div>
    </div>

    @* Manage Payments Button (Stripe Customer Portal) *@
    @if (Model.HasStripeIntegration)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="ri-bank-card-2-line me-2"></i> Manage Payment Methods</h3>
            </div>
            <div class="card-body">
                <p class="text-secondary">Update your cards, view invoices, and manage your subscription through the secure Stripe portal.</p>
                <form asp-action="OpenCustomerPortal" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Billing")" />
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-external-link-line me-1"></i> Open Payments Portal
                    </button>
                </form>
            </div>
        </div>

    }

    @* Upcoming Invoice *@
    @if (Model.UpcomingInvoice != null)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="ri-bill-line me-2"></i> Upcoming Invoice</h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-secondary small">Estimated Amount</div>
                        <div class="h2 text-primary mb-0">€@Model.UpcomingInvoice.AmountDue.ToString("N2")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-secondary small">Billing Period</div>
                        <div class="fw-semibold">
                            @Model.UpcomingInvoice.CreatedUtc?.ToString("dd/MM/yyyy") -
                            @Model.UpcomingInvoice.DueDateUtc?.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Invoices History *@
    @if (Model.RecentInvoices.Any())
    {
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="ri-file-list-line me-2"></i> Invoice History</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Number</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th class="w-1">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model.RecentInvoices.OrderByDescending(i => i.Date))
                        {
                            <tr class="invoice-row">
                                <td>@invoice.Date.ToString("dd/MM/yyyy")</td>
                                <td><code>@invoice.InvoiceNumber</code></td>
                                <td><strong>€@invoice.Amount.ToString("N2")</strong></td>
                                <td>
                                    @if (invoice.IsPaid)
                                    {
                                        <span class="badge bg-green-lt">Paid</span>
                                    }
                                    else if (invoice.Status == "open")
                                    {
                                        <span class="badge bg-yellow-lt">Pending</span>
                                    }
                                    else if (invoice.Status == "void")
                                    {
                                        <span class="badge bg-secondary-lt">Canceled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt">@invoice.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(invoice.PdfUrl))
                                    {
                                        <a href="@invoice.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="ri-download-line"></i> PDF
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Upgrade/Downgrade Modal *@
    @if (Model.AvailablePlans.Any())
    {
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="ri-refresh-line me-2"></i> Change Plan</h3>
            </div>
            <div class="card-body">
                <p class="text-secondary">Choose a plan that fits your needs.</p>
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#changePlanModal">
                    <i class="ri-arrow-left-right-line me-1"></i> Change Plan
                </button>
            </div>
        </div>

        <!-- Change Plan Modal -->
        <div class="modal modal-blur fade" id="changePlanModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Change Subscription Plan</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-secondary">Select the new plan you want to activate. The change will take effect immediately.</p>
                        <div class="row g-3">
                            @foreach (var plan in Model.AvailablePlans.Where(p => p.PlanID != Model.SubscriptionID))
                            {
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">@plan.Name</h5>
                                            <p class="card-text text-secondary small">@plan.Description</p>
                                            <h4 class="text-primary">€@plan.Price.ToString("N2")</h4>
                                            <small class="text-secondary">/@(plan.BillingCycle == BillingCycle.MONTHLY ? "month" : "year")</small>
                                            <form asp-action="ChangePlan" method="post" class="mt-3">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="subscriptionId" value="@Model.SubscriptionID" />
                                                <input type="hidden" name="newPlanId" value="@plan.PlanID" />
                                                <button type="submit" class="btn btn-primary w-100">
                                                    Select Plan
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- No Active Subscription -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="empty">
                <div class="empty-img">
                    <i class="ri-vip-crown-line" style="font-size: 72px;"></i>
                </div>
                <p class="empty-title">No Active Subscription</p>
                <p class="empty-subtitle text-secondary">You don't have an active subscription yet. Contact the administrator to activate your plan.</p>

                @if (Model.AvailablePlans.Any())
                {
                    <div class="mt-4">
                        <h3 class="h4 mb-3">Available Plans</h3>
                        <div class="row row-cards justify-content-center">
                            @foreach (var plan in Model.AvailablePlans.Take(3))
                            {
                                <div class="col-12 col-md-4">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="h3 mb-1">@plan.Name</div>
                                            <div class="h2 text-primary mb-0">€@plan.Price.ToString("N2")</div>
                                            <div class="text-secondary small">/@(plan.BillingCycle == BillingCycle.MONTHLY ? "month" : "year")</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
