@* _WidgetCard.cshtml *@
@model (string Id, string Label, string IconClass, string ExtraClass)
<div class="d-flex justify-content-between align-items-start @Model.ExtraClass">
    <div>
        <h4 class="mb-0" id="@Model.Id"></h4>
        <p class="mb-0">@Model.Label</p>
    </div>
    <div class="avatar me-sm-6">
        <span class="avatar-initial rounded-3">
            <i class="icon-base @Model.IconClass text-heading icon-26px"></i>
        </span>
    </div>
</div>