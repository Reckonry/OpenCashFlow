@{
  // Availabel Layout option added for this template :
  // _ContentNavbarLayout : Vertical Layout
  // _BlankLayout : Blank Layout
  // _HorizontalLayout : Horizontal Layout
  // _NavbarFullLayout : Full Navbar Layout
  Layout = "_ContentNavbarLayout";
 // Layout = "_MasterPage";

  // Default layout flags for internal pages (menu + navbar + footer visible)
  // Individual views can override these by setting ViewData["isMenu"] = false; etc.
  ViewData["isMenu"] = true;
  ViewData["isNavbar"] = true;
  ViewData["isFooter"] = true;
}
