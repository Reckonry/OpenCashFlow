@using System.Linq
@using OpenCashFlow.Contracts.Core
@using OpenCashFlow.Contracts.DTOs.Employees
@model Employee_Detail_DTO
@{
  ViewData["Title"] = Localizer["UserProfileTitle"].Value;
  var displayName = (Model?.EmployeeSurnameName ?? ($"{Model?.UserFirstName} {Model?.UserLastName}")).Trim();
  if (string.IsNullOrWhiteSpace(displayName))
  {
    displayName = Localizer["FullName"].Value;
  }
  var hasAvatar = !string.IsNullOrWhiteSpace(Model?.UserAvatar);
  var avatarInfo = hasAvatar
    ? (BgColor: string.Empty, TextColor: string.Empty, Initials: string.Empty)
    : AvatarGenerator.GetAvatar(displayName ?? string.Empty);
}

@section VendorStyles{
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.css">
}

@section VendorScripts {
<script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageStyles{
<link rel="stylesheet" href="~/vendor/css/pages/page-profile.css" />
}

@section PageScripts {
<script src="~/js/pages-profile-user.js"></script>
}

@* ************** Content ************** *@

<div class="container-xl">

  <div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
      <div class="col">
        <h2 class="page-title">@Localizer["UserProfileTitle"]</h2>
        <div class="text-secondary mt-1">@Localizer["ProfileTab"]</div>
      </div>
      <div class="col-auto ms-auto">
        <a href="~/Account/Edit" class="btn btn-primary" aria-label="@Localizer["EditProfile"]">
          <i class='ri-user-settings-line me-2'></i>@Localizer["EditProfile"]
        </a>
      </div>
    </div>
  </div>

  <div class="row row-cards">

    @* Profile header *@
    <div class="col-12">
      <div class="card">
        <div class="card-body p-0">

          <div class="ratio ratio-21x9">
            <img src="~/img/pages/profile-banner.png" alt="@Localizer["ProfileBannerAlt"]" class="w-100 h-100" style="object-fit: cover;">
          </div>

          <div class="p-4">
            <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start">

              <div class="me-md-4 mb-3 mb-md-0" style="margin-top: -64px;">
                @if (hasAvatar)
                {
                  <span class="avatar avatar-xl" style="background-image: url('@Url.Content(Model?.UserAvatar ?? string.Empty)'); border: 4px solid var(--tblr-card-bg);"></span>
                }
                else
                {
                  <span class="avatar avatar-xl" style="background-color:@avatarInfo.BgColor; color:@avatarInfo.TextColor; border: 4px solid var(--tblr-card-bg);">
                    @avatarInfo.Initials
                  </span>
                }
              </div>

              <div class="flex-fill text-center text-md-start">
                <h3 class="mb-1">@displayName</h3>

                @{ var roleNames = Model?.Roles?.Where(r => r != null && !string.IsNullOrWhiteSpace(r.RoleName)).Select(r => r.RoleName).ToList();
                   string rolesText;
                   if (roleNames != null && roleNames.Any())
                   {
                     var roleDisplayNames = roleNames.Select(roleName =>
                     {
                       var localizedValue = Localizer[$"Role_{roleName}"]?.Value;
                       return string.IsNullOrWhiteSpace(localizedValue) || string.Equals(localizedValue, $"Role_{roleName}", StringComparison.OrdinalIgnoreCase)
                         ? roleName
                         : localizedValue;
                     });
                     rolesText = string.Join(", ", roleDisplayNames);
                   }
                   else if (!string.IsNullOrWhiteSpace(Model?.Role))
                   {
                     var localizedValue = Localizer[$"Role_{Model.Role}"]?.Value;
                     rolesText = string.IsNullOrWhiteSpace(localizedValue) || string.Equals(localizedValue, $"Role_{Model.Role}", StringComparison.OrdinalIgnoreCase)
                       ? Model.Role
                       : localizedValue;
                   }
                   else
                   {
                     rolesText = "-/-";
                   }
                   var locationText = !string.IsNullOrWhiteSpace(Model?.WorkLocation) ? Model.WorkLocation : (Model?.Country ?? "");
                   var joinedText = (Model?.DateIns != default) ? $"{Localizer["Joined"].Value} {Model?.DateIns.ToString("MMMM yyyy")}" : string.Empty; }

                <div class="text-secondary">
                  <ul class="list-inline mb-0">
                    @if (!string.IsNullOrWhiteSpace(rolesText))
                    {
                      <li class="list-inline-item me-3">
                        <i class='ri-palette-line me-1'></i><span class="fw-semibold">@rolesText</span>
                      </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(locationText))
                    {
                      <li class="list-inline-item me-3">
                        <i class='ri-map-pin-line me-1'></i><span class="fw-semibold">@locationText</span>
                      </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(joinedText))
                    {
                      <li class="list-inline-item">
                        <i class='ri-calendar-line me-1'></i><span class="fw-semibold">@joinedText</span>
                      </li>
                    }
                  </ul>
                </div>

              </div>

            </div>
          </div>

        </div>
      </div>
    </div>

    @* Tabs (only Profile enabled for now) *@
    <div class="col-12">
      <ul class="nav nav-tabs nav-fill">
        <li class="nav-item">
          <a class="nav-link active" href="javascript:void(0);">
            <i class='ri-user-3-line me-1'></i>@Localizer["ProfileTab"]
          </a>
        </li>
        @* <li class="nav-item"><a class="nav-link" href="ProfileTeams"><i class='ri-team-line me-1'></i>@Localizer["TeamsTab"]</a></li>
           <li class="nav-item"><a class="nav-link" href="ProfileProjects"><i class='ri-computer-line me-1'></i>@Localizer["ProjectsTab"]</a></li>
           <li class="nav-item"><a class="nav-link" href="ProfileConnections"><i class='ri-link-m me-1'></i>@Localizer["ConnectionsTab"]</a></li> *@
      </ul>
    </div>

    @* Profile content *@
    <div class="col-12 col-xl-4 col-lg-5 col-md-6">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0">@Localizer["About"]</h3>
        </div>
        <div class="card-body">

          <div class="text-uppercase text-secondary fw-semibold small mb-2">@Localizer["Details"]</div>
          <ul class="list-unstyled mb-4">
            <li class="d-flex align-items-center mb-2">
              <i class="ri-user-3-line me-2 text-secondary"></i>
              <span class="fw-semibold me-1">@Localizer["FullName"]:</span>
              <span>@(Model?.EmployeeSurnameName?.Trim() ?? "-/-")</span>
            </li>

            <li class="d-flex align-items-center mb-2">
              <i class="ri-check-line me-2 text-secondary"></i>
              <span class="fw-semibold me-1">@Localizer["Status"]:</span>
              @if (Model?.IsApproved == true)
              {
                <span class="badge bg-green-lt">@Localizer["Active"]</span>
              }
              else if (Model?.IsApproved == false)
              {
                <span class="badge bg-yellow-lt">@Localizer["NotActive"]</span>
              }
              else
              {
                <span>-/-</span>
              }
            </li>

            <li class="d-flex align-items-center mb-2">
              <i class="ri-star-smile-line me-2 text-secondary"></i>
              <span class="fw-semibold me-1">@Localizer["Role"]:</span>
              @{ var roleNames2 = Model?.Roles?.Where(r => r != null && !string.IsNullOrWhiteSpace(r.RoleName)).Select(r => r.RoleName).ToList();
                 string rolesText2;
                 if (roleNames2 != null && roleNames2.Any())
                 {
                   var roleDisplayNames2 = roleNames2.Select(roleName =>
                   {
                     var localizedValue = Localizer[$"Role_{roleName}"]?.Value;
                     return string.IsNullOrWhiteSpace(localizedValue) || string.Equals(localizedValue, $"Role_{roleName}", StringComparison.OrdinalIgnoreCase)
                       ? roleName
                       : localizedValue;
                   });
                   rolesText2 = string.Join(", ", roleDisplayNames2);
                 }
                 else if (!string.IsNullOrWhiteSpace(Model?.Role))
                 {
                   var localizedValue = Localizer[$"Role_{Model.Role}"]?.Value;
                   rolesText2 = string.IsNullOrWhiteSpace(localizedValue) || string.Equals(localizedValue, $"Role_{Model.Role}", StringComparison.OrdinalIgnoreCase)
                     ? Model.Role
                     : localizedValue;
                 }
                 else
                 {
                   rolesText2 = "-/-";
                 } }
              <span>@rolesText2</span>
            </li>

            @if (!string.IsNullOrWhiteSpace(Model?.Country))
            {
              <li class="d-flex align-items-center mb-2">
                <i class="ri-flag-2-line me-2 text-secondary"></i>
                <span class="fw-semibold me-1">@Localizer["Country"]:</span>
                <span>@Model.Country</span>
              </li>
            }

            @if (!string.IsNullOrWhiteSpace(Model?.Language))
            {
              <li class="d-flex align-items-center">
                <i class="ri-translate-2-line me-2 text-secondary"></i>
                <span class="fw-semibold me-1">@Localizer["Languages"]:</span>
                <span>@Model.Language</span>
              </li>
            }
          </ul>

          <div class="text-uppercase text-secondary fw-semibold small mb-2">@Localizer["Contacts"]</div>
          <ul class="list-unstyled mb-4">
            @if (!string.IsNullOrWhiteSpace(Model?.PhoneNumber) || !string.IsNullOrWhiteSpace(Model?.PhoneNumberPrefix))
            {
              <li class="d-flex align-items-center mb-2">
                <i class="ri-phone-line me-2 text-secondary"></i>
                <span class="fw-semibold me-1">@Localizer["Contact"]:</span>
                <span>@(Model?.PhoneNumberPrefix) @(Model?.PhoneNumber)</span>
              </li>
            }
            @if (!string.IsNullOrWhiteSpace(Model?.Email))
            {
              <li class="d-flex align-items-center">
                <i class="ri-mail-open-line me-2 text-secondary"></i>
                <span class="fw-semibold me-1">@Localizer["Email"]:</span>
                <span>@Model.Email</span>
              </li>
            }
          </ul>

          <div class="text-uppercase text-secondary fw-semibold small mb-2">@Localizer["Organization"]</div>
          <ul class="list-unstyled mb-0">
            @if (!string.IsNullOrWhiteSpace(Model?.Department))
            {
              <li class="d-flex align-items-center mb-2">
                <i class="ri-briefcase-3-line me-2 text-secondary"></i>
                <span class="fw-semibold me-1">@Localizer["Department"]:</span>
                <span>@Model.Department</span>
              </li>
            }
            @if (!string.IsNullOrWhiteSpace(Model?.WorkLocation))
            {
              <li class="d-flex align-items-center">
                <i class="ri-map-pin-2-line me-2 text-secondary"></i>
                <span class="fw-semibold me-1">@Localizer["WorkLocation"]:</span>
                <span>@Model.WorkLocation</span>
              </li>
            }
          </ul>

        </div>
      </div>
    </div>

  </div>

</div>
