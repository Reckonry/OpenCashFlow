@model OpenCashFlow.WebApp.Models.ResetPasswordViewModel
@{
    Layout = "_BlankLayout";

    ViewData["Title"] = Localizer["ResetPasswordTitle"].Value;
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/@@form-validation/form-validation.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/@@form-validation/popular.js"></script>
    <script src="~/vendor/libs/@@form-validation/bootstrap5.js"></script>
    <script src="~/vendor/libs/@@form-validation/auto-focus.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
}

@section PageScripts {
    <script src="~/js/pages-auth.js"></script>
    <script src="~/js/pages/auth-reset-password.js" asp-append-version="true"></script>
}
<div class="page page-center">
    <div class="container container-tight py-4">

        <div class="text-center mb-4">
            <a href="/" class="navbar-brand navbar-brand-autodark">
                @await Html.PartialAsync("../_Partials/_Macros")
                <span class="ms-2 fw-semibold">@TempData.Peek("appName")</span>
            </a>
        </div>

        <div class="card card-md">
            <div class="card-body">

                <h2 class="h2 text-center mb-3">@Localizer["ResetPasswordHeading"]</h2>

                @if (ViewBag.ErrorMessage != null && (Model == null || string.IsNullOrWhiteSpace(Model.Token)))
                {
                    <!-- Invalid or expired token -->
                    <div class="text-center">
                        <div class="mb-4">
                            <i class="ri-error-warning-line fs-1 text-danger"></i>
                        </div>

                        <div class="alert alert-danger" role="alert">
                            <div class="fw-semibold">@ViewBag.ErrorTitle ?? "Invalid link"</div>
                            <div class="text-secondary">@ViewBag.ErrorMessage</div>
                        </div>

                        <div class="mt-4">
                            <a href="/Account/ForgotPassword" class="btn btn-primary d-inline-flex align-items-center">
                                <i class="ri-mail-send-line me-2"></i>
                                Request a new link
                            </a>
                            <div class="text-secondary mt-2">You will receive an email shortly with a new link to reset your password.</div>
                        </div>
                    </div>
                }
                else if (ViewBag.SuccessMessage != null)
                {
                    <!-- Success -->
                    <div class="text-center">
                        <div class="mb-4">
                            <i class="ri-check-double-line fs-1 text-success"></i>
                        </div>

                        <div class="alert alert-success" role="alert">
                            <div class="fw-semibold">@ViewBag.SuccessTitle ?? "Password reset!"</div>
                            <div class="text-secondary">@ViewBag.SuccessMessage</div>
                        </div>

                        <div class="mt-4">
                            <a href="/" class="btn btn-primary d-inline-flex align-items-center">
                                <i class="ri-login-box-line me-2"></i>
                                Sign in now
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Standard form -->
                    <p class="text-secondary text-center mb-4">@Localizer["ResetPasswordSubtitle"]</p>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <div class="d-flex">
                                <div class="me-3">
                                    <i class="ri-error-warning-line fs-3 text-danger"></i>
                                </div>
                                <div>
                                    @ViewBag.ErrorMessage
                                </div>
                            </div>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-action="ResetPassword" asp-controller="Home" method="post" id="formAuthentication" class="mb-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label class="form-label" asp-for="Password"></label>
                            <div class="input-group">
                                <input asp-for="Password" class="form-control"
                                       pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@@#$%^&*()_+\-=\[\]{};':&quot;\\|,.&lt;&gt;\/?]).{8,}$"
                                       title="At least 8 characters, one uppercase, one lowercase, one number, and one special character."
                                       autocomplete="new-password" />
                                <span class="input-group-text"><i class="ri-eye-off-line"></i></span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="ConfirmPassword"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span class="input-group-text"><i class="ri-eye-off-line"></i></span>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="form-footer">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="ri-lock-password-line me-2"></i>
                                @Localizer["ResetPasswordButton"]
                            </button>
                        </div>
                    </form>
                }

            </div>
        </div>

        <div class="text-center text-secondary mt-3">
            <a href="/Account/LogIn">@Localizer["BackToLogin"]</a>
        </div>

    </div>
</div>
