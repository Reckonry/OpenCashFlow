@using System.Security.Claims;
@using OpenCashFlow.App.Controllers;

@{
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<ul class="nav nav-tabs nav-fill mb-4">
    <li class="nav-item">
        <a class="nav-link @(currentAction == "Index" ? "active" : "")"
           href="@(currentAction == "Index" ? "#" : "/Company")">
            <i class="ri-building-4-line me-1"></i>
            @Localizer["Account"]
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(currentAction == "Company_CashLedger" ? "active" : "")"
           href="@(currentAction == "Company_CashLedger" ? "#" : "/Company/CashLedger")">
            <i class="ri-cash-line me-1"></i>
            @Localizer["CashLedger"]
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(currentAction == "Company_Payment_Methods" ? "active" : "")"
           href="@(currentAction == "Company_Payment_Methods" ? "#" : "/Company/Payment_Methods")">
            <i class="ri-wallet-3-line me-1"></i>
            @Localizer["PaymentMethods"]
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(currentAction == "Company_Payment_DocumentTypes" ? "active" : "")"
           href="@(currentAction == "Company_Payment_DocumentTypes" ? "#" : "/Company/Payment_DocumentTypes")">
            <i class="ri-file-text-line me-1"></i>
            @Localizer["DocumentTypes"]
        </a>
    </li>
</ul>
