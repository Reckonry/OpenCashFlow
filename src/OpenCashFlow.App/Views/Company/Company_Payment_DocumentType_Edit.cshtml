@model Payment_DocumentType_Update_DTO
@{
    ViewData["Title"] = Localizer["DocumentTypeEditTitle"].Value;
}

@await Html.PartialAsync("Components/_Company_ViewHeader", ViewData)

<div class="card">
  <h5 class="card-header">@Localizer["DocumentTypeEditHeading"]</h5>
  <div class="card-body">
    <div class="alert alert-info mb-3">
      <i class="ri-information-line me-2"></i>@Localizer["DocumentTypeExplanation"]
    </div>
    <form method="post" action="/Company/Payment_DocumentTypes/Edit">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="DocumentTypeID" />
      <input type="hidden" asp-for="TenantID" />
      <div class="mb-3">
        <label class="form-label" for="DocumentTypeName">@Localizer["DocumentTypeName"]</label>
        <input class="form-control" asp-for="DocumentTypeName" placeholder="@Localizer["EnterDocumentTypeName"]" aria-label="@Localizer["DocumentTypeName"]" />
        <span class="text-danger" asp-validation-for="DocumentTypeName"></span>
      </div>
      <div class="mb-3">
        <label class="form-label" for="DocumentTypeDescription">@Localizer["DocumentTypeDescription"]</label>
        <input class="form-control" asp-for="DocumentTypeDescription" placeholder="@Localizer["EnterDocumentTypeDescription"]" aria-label="@Localizer["DocumentTypeDescription"]" />
        <span class="text-danger" asp-validation-for="DocumentTypeDescription"></span>
      </div>

      <div class="mt-3">
        <button type="submit" class="btn btn-primary" >@SharedLocalizer["Save"]</button>
        <a class="btn btn-secondary" href="/Company/Payment_DocumentTypes">@SharedLocalizer["Cancel"]</a>
      </div>
    </form>
  </div>
</div>
