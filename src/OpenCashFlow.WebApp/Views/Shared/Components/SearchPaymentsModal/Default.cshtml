@using Shared.Models.DTOs
@model Shared.DTOs.Payment_Filter_DTO

<!-- Search Payments Modal (Tabler aligned) -->
<div class="modal modal-blur fade" id="editUser" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">@Localizer["Payments Search"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <p class="text-secondary mb-4">@Localizer["From here you can search saved transactions."]</p>

        <form id="searchPaymentsForm" class="" method="post">

          <div class="row g-3">

            @* Range date *@
            <div class="col-12 col-md-6">
              <label class="form-label" asp-for="FromDate">@Localizer["StartDate"]</label>
              <input type="date" asp-for="FromDate" class="form-control" value="@Model?.FromDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label" asp-for="ToDate">@Localizer["EndDate"]</label>
              <input type="date" asp-for="ToDate" class="form-control" value="@Model?.ToDate?.ToString("yyyy-MM-dd")" />
            </div>

            @* Amount range *@
            <div class="col-12 col-md-6">
              <label class="form-label" asp-for="MinAmount">@Localizer["MinAmount"]</label>
              <input type="number" step="0.01" asp-for="MinAmount" class="form-control" value="@Model?.MinAmount" />
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label" asp-for="MaxAmount">@Localizer["MaxAmount"]</label>
              <input type="number" step="0.01" asp-for="MaxAmount" class="form-control" value="@Model?.MaxAmount" />
            </div>

            @* Entry Type *@
            <div class="col-12 col-md-6">
              <label class="form-label" asp-for="EntryType">@Localizer["EntryType"]</label>
              <select asp-for="EntryType" class="form-select">
                <option value="">@Localizer["All"]</option>
                <option value="Income">@SharedLocalizer["Income"]</option>
                <option value="Outcome">@SharedLocalizer["Outcome"]</option>
              </select>
            </div>

            @* Document Type *@
            <div class="col-12 col-md-6">
              <label class="form-label" asp-for="DocumentTypeID">@Localizer["DocumentType"]</label>
              <select asp-for="DocumentTypeID" class="form-select">
                <option value="">@Localizer["All"]</option>
                @{
                  if (ViewBag.DocumentTypeList != null)
                  {
                    foreach (Payment_DocumentType_List_DTO item in ViewBag.DocumentTypeList)
                    {
                      <option value="@item.DocumentTypeID.ToString()">@SharedLocalizer[item.DocumentTypeDescription!]</option>
                    }
                  }
                }
              </select>
            </div>

            @* Payment Method *@
            <div class="col-12 col-md-6">
              <label class="form-label" asp-for="PaymentMethodID">@Localizer["PaymentMethod"]</label>
              <select asp-for="PaymentMethodID" class="form-select">
                <option value="">@Localizer["All"]</option>
                @{
                  if (ViewBag.PaymentMethodList != null)
                  {
                    foreach (Payment_Method_List_DTO item in ViewBag.PaymentMethodList)
                    {
                      <option value="@item.PaymentMethodID.ToString()">@SharedLocalizer[item.PaymentMethodName]</option>
                    }
                  }
                }
              </select>
            </div>

            @* Description *@
            <div class="col-12">
              <label class="form-label" asp-for="Description">@Localizer["Description"]</label>
              <input type="text" asp-for="Description" class="form-control" value="@Model?.Description" />
            </div>

          </div>

          <div class="modal-footer mt-4">
            <button type="submit" class="btn btn-primary" id="SubmitButtonSearch">@Localizer["Search"]</button>

            <button class="btn btn-primary d-none" id="LoadingSearch" type="button" disabled>
              <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@Localizer["Loading"]
            </button>

            <button type="button" class="btn btn-outline-secondary" id="DiscardSearch" data-bs-dismiss="modal">@Localizer["Discard"]</button>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>
