@{
    ViewData["Title"] = "Subscription expired";
}

<section class="gi-page gi-page--center gi-page--narrow">
    <div class="gi-card gi-card--shadow">
        <div class="gi-card__header">
            <h1 class="gi-card__title">Subscription inactive</h1>
        </div>
        <div class="gi-card__body">
            <p>
                Access to OpenCashFlow has been temporarily suspended because the subscription
                has expired or was not renewed.
            </p>
            <p>
                Contact our team or update the payment method to reactivate services immediately.
            </p>
        </div>
        <div class="gi-card__footer">
            <a class="gi-button gi-button--primary" href="/Billing/Plans">Go to subscription plans</a>
            <a class="gi-button gi-button--ghost" href="mailto:support@opencashflow.cloud">Contact support</a>
        </div>
    </div>
</section>
