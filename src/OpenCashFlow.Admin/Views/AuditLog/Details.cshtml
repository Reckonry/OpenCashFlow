@model OpenCashFlow.Admin.Models.AuditLog.AuditLogDetailViewModel
@{
    ViewData["Title"] = "Dettaglio Audit Log";
    var log = Model.Log;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1>Dettaglio Audit Log</h1>
                <p class="text-muted mb-0">Evento @log.EventType su @log.Resource</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ri-arrow-left-line me-1"></i> Torna all'elenco
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Informazioni generali</h5>

                    <dl class="row mb-0">
                        <dt class="col-sm-5">Timestamp</dt>
                        <dd class="col-sm-7">@log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</dd>

                        <dt class="col-sm-5">Evento</dt>
                        <dd class="col-sm-7"><span class="badge bg-label-primary">@log.EventType</span></dd>

                        <dt class="col-sm-5">Resource</dt>
                        <dd class="col-sm-7">
                            <div>@log.Resource</div>
                            @if (!string.IsNullOrWhiteSpace(log.ResourceID))
                            {
                                <div class="text-muted small">@log.ResourceID</div>
                            }
                        </dd>

                        <dt class="col-sm-5">Severity</dt>
                        <dd class="col-sm-7">
                            @{
                                var severity = log.Severity ?? "Info";
                                var badgeClass = severity switch
                                {
                                    "Critical" => "badge bg-danger",
                                    "Error" => "badge bg-danger",
                                    "Warning" => "badge bg-warning text-dark",
                                    _ => "badge bg-success"
                                };
                            }
                            <span class="@badgeClass">@severity</span>
                        </dd>

                        <dt class="col-sm-5">Utente</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(log.Username))
                            {
                                <span>@log.Username</span>
                            }
                            else if (log.UserID.HasValue)
                            {
                                <span class="text-muted">@log.UserID</span>
                            }
                            else
                            {
                                <span class="text-muted">Sistema</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Company</dt>
                        <dd class="col-sm-7">
                            @(log.TenantID.HasValue ? log.TenantID.ToString() : "-")
                        </dd>

                        <dt class="col-sm-5">IP Address</dt>
                        <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(log.IPAddress) ? log.IPAddress : "-")</dd>

                        <dt class="col-sm-5">User Agent</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(log.UserAgent))
                            {
                                <span>@log.UserAgent</span>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Action Details</h5>
                    <p class="mb-0">@log.Action</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Changes</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.FormattedChanges))
                    {
                        <pre class="bg-light p-3 rounded border">@Model.FormattedChanges</pre>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No details available.</p>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Additional information</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.FormattedAdditionalInfo))
                    {
                        <pre class="bg-light p-3 rounded border">@Model.FormattedAdditionalInfo</pre>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No additional information.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
