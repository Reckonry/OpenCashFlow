@{
    ViewData["Title"] = Localizer["ChangePasswordTitle"].Value;
}

@section PageScripts {
    <script src="~/js/pages/auth-change-password.js" asp-append-version="true"></script>
}

<div class="page page-center">
    <div class="container container-tight py-4">

        <div class="card card-md">
            <div class="card-body">

                <h2 class="h2 text-center mb-2">@Localizer["ChangePasswordHeading"]</h2>
                <p class="text-secondary text-center mb-4">@Localizer["ChangePasswordSubtitle"]</p>

                @if (TempData["PasswordChangeSuccessMessage"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        @TempData["PasswordChangeSuccessMessage"]
                    </div>
                }
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <div id="passwordError"
                     class="alert alert-danger d-none"
                     role="alert"
                     data-passwords-mismatch-message="@Localizer["Passwords do not match"]"
                     data-password-requirements-message="@Localizer["PasswordNotMeetRequirements"]"></div>

                <form asp-action="ChangePassword" method="post" class="mb-3">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" for="NewPassword">@Localizer["NewPassword"]</label>
                        <div class="input-group">
                            <input type="password" name="NewPassword" id="NewPassword" class="form-control"
                                   placeholder="@Localizer["EnterNewPassword"]"
                                   aria-label="@Localizer["NewPassword"]"
                                   required autocomplete="new-password" />
                            <span class="input-group-text cursor-pointer toggle-password" data-target="#NewPassword">
                                <i class="ri-eye-off-line"></i>
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="RepeatPassword">@Localizer["ConfirmNewPassword"]</label>
                        <div class="input-group">
                            <input type="password" name="RepeatPassword" id="RepeatPassword" class="form-control"
                                   placeholder="@Localizer["ConfirmYourNewPassword"]"
                                   aria-label="@Localizer["ConfirmNewPassword"]"
                                   required autocomplete="new-password" />
                            <span class="input-group-text cursor-pointer toggle-password" data-target="#RepeatPassword">
                                <i class="ri-eye-off-line"></i>
                            </span>
                        </div>
                    </div>

                    <!-- Password Requirements Hint -->
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>@Localizer["PasswordRequirements"]:</strong>
                        <ul class="mb-0 mt-2" id="passwordRequirementsList">
                            <li id="req-length" class="text-muted">
                                <i class="ri-checkbox-blank-circle-line me-1"></i>
                                <span>@Localizer["MinLength8Chars"]</span>
                            </li>
                            <li id="req-uppercase" class="text-muted">
                                <i class="ri-checkbox-blank-circle-line me-1"></i>
                                <span>@Localizer["AtLeastOneUppercase"]</span>
                            </li>
                            <li id="req-lowercase" class="text-muted">
                                <i class="ri-checkbox-blank-circle-line me-1"></i>
                                <span>@Localizer["AtLeastOneLowercase"]</span>
                            </li>
                            <li id="req-digit" class="text-muted">
                                <i class="ri-checkbox-blank-circle-line me-1"></i>
                                <span>@Localizer["AtLeastOneDigit"]</span>
                            </li>
                            <li id="req-special" class="text-muted">
                                <i class="ri-checkbox-blank-circle-line me-1"></i>
                                <span>@Localizer["AtLeastOneSpecial"]</span>
                            </li>
                        </ul>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">
                        @Localizer["ChangePasswordButton"]
                    </button>
                </form>

                <form asp-action="KeepCurrentPassword" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        @Localizer["KeepCurrentPassword"]
                    </button>
                </form>

            </div>
        </div>

    </div>
</div>
