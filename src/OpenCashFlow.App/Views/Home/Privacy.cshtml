@{
    ViewData["Title"] = Localizer["PrivacyTitle"].Value;
}
<div class="container-xl">

  <div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
      <div class="col">
        <h2 class="page-title">@Localizer["PrivacyHeading"]</h2>
      </div>
    </div>
  </div>

  <div class="row row-cards">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <p class="text-secondary mb-0">@Localizer["PrivacyIntro"]</p>
        </div>
      </div>
    </div>
  </div>

</div>
