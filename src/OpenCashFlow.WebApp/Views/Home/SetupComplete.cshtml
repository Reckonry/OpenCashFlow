@model OpenCashFlow.WebApp.Models.Setup.SetupCompleteViewModel
@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "Setup complete";
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
}

<div class="page page-center">
  <div class="container container-tight py-4">
    <div class="text-center mb-4">
      <a href="/" class="navbar-brand navbar-brand-autodark">
        <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
        <span class="app-brand-text demo text-heading fw-semibold ms-2">OpenCashFlow</span>
      </a>
    </div>

    <div class="card card-md">
      <div class="card-body">
        <h1 class="h2 text-center mb-2">Setup complete</h1>
        <p class="text-center text-secondary mb-4">Store this temporary administrator password now. It will not be shown again.</p>

        <div class="mb-3">
          <label class="form-label">Admin email</label>
          <input class="form-control" value="@Model.AdminEmail" readonly />
        </div>

        <div class="mb-3">
          <label class="form-label">Temporary password</label>
          <input class="form-control font-monospace" value="@Model.TemporaryAdminPassword" readonly />
        </div>

        <div class="alert alert-warning">
          You will be asked to change this password after the first login.
        </div>

        <a class="btn btn-primary w-100" asp-action="Login" asp-controller="Home">Go to login</a>
      </div>
    </div>
  </div>
</div>
