@using System.Security.Claims;
@using Shared.DTOs.Employees
@model Employee_Detail_DTO

@{
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}


@if (Model != null)
{
    <div class="card mb-4">
        <div class="card-body">

            <div class="row align-items-center g-3">

                <div class="col-auto">
                    <span class="avatar avatar-xl">
                        <img src="@(string.IsNullOrEmpty(Model.UserAvatar) ? @Url.Content("~/img/avatars/employee-icon.jpg") : @Url.Content(Model.UserAvatar))"
                             alt="@Localizer["EmployeeImageAlt"]" />
                    </span>
                </div>

                <div class="col">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h2 class="h3 m-0">@Html.Raw(Model.EmployeeSurnameName?.Trim())</h2>

                        @if (Model.OutOfReports)
                        {
                            <span class="badge bg-yellow-lt">@Localizer["Out of reports"]</span>
                        }
                    </div>

                    <div class="mt-2">
                        <ul class="list list-inline list-inline-dots text-secondary mb-0">

                            @if (!string.IsNullOrEmpty(Model.Country))
                            {
                                <li class="list-inline-item">
                                    <i class="ti ti-map-pin me-1"></i>
                                    @Model.Country?.Trim()
                                </li>
                            }

                            @if (!string.IsNullOrEmpty(Model.TimeCost?.ToString()))
                            {
                                <li class="list-inline-item">
                                    <i class="ti ti-file-dollar me-1"></i>
                                    <span class="contain-price">@Html.Raw(Model.TimeCost?.ToString("#,##0.'<small>'00#'</small>'"))</span>@Localizer["/hour"]
                                </li>
                            }

                            <li class="list-inline-item">
                                <i class='ti ti-calendar me-1'></i>
                                <span class="text-muted">@Localizer["Added"]</span>
                                @Model.DateIns.ToLongDateString()
                            </li>

                        </ul>
                    </div>
                </div>

                <div class="col-auto ms-auto">
                    @{
                        // if (User.FindFirst(ClaimTypes.Role)?.Value == nameof(Core_Roles.Administrator) ||
                        // User.FindFirst(ClaimTypes.Role)?.Value == nameof(Core_Roles.Employer) ||
                        // User.FindFirst(ClaimTypes.Role)?.Value == nameof(Core_Roles.Accountant) ||
                        // User.FindFirst(nameof(Permissions.Employees.EMPL_EDIT))?.Value == true.ToString())
                        // {
                            <a href="~/Employees/Edit/@Model.UserID" class="btn btn-warning">
                                <i class='fa fa-pencil me-1'></i>@Localizer["Edit details"]
                            </a>
                        // }
                    }
                </div>

            </div>

        </div>
    </div>
}
