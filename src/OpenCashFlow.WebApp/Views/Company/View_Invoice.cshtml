@using OpenCashFlow.Contracts.DTOs.Companies
@model CompanyInvoiceDetailViewModel

@{
	ViewData["Title"] = Localizer["InvoicePreviewTitle"].Value;
}

@section VendorStyles {
<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css">
}

@section VendorScripts {
<script src="~/vendor/libs/moment/moment.js"></script>
<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="~/vendor/libs/cleavejs/cleave.js"></script>
<script src="~/vendor/libs/cleavejs/cleave-phone.js"></script>
}

@section PageStyles {
<link rel="stylesheet" href="~/vendor/css/pages/app-invoice.css" />
}

@section PageScripts {
<script src="~/js/offcanvas-add-payment.js"></script>
<script src="~/js/offcanvas-send-invoice.js"></script>
}

@* Page header (Tabler style) *@
<div class="page-header d-print-none mb-4">
	<div class="row align-items-center">
		<div class="col">
			<h2 class="page-title">@Localizer["InvoicePreviewTitle"]</h2>
			<div class="text-secondary mt-1">@Localizer["Invoice"] #@Model.InvoiceNumber</div>
		</div>
		<div class="col-auto ms-auto d-print-none">
			<div class="btn-list">
				<a class="btn btn-outline-secondary" target="_blank" href="~/Company/Invoices/View/@Model.InvoiceID/Print">
					<i class="ri-printer-line me-2"></i>@Localizer["PrintButton"]
				</a>
				<button class="btn btn-primary" type="button">
					<i class="ri-download-2-line me-2"></i>@Localizer["DownloadButton"]
				</button>
			</div>
		</div>
	</div>
</div>

<div class="row row-cards">
	@* Invoice *@
	<div class="col-12 col-lg-9">
		<div class="card">
			<div class="card-body">

				<div class="d-flex justify-content-between flex-wrap gap-4 mb-4">
					<div>
						<div class="d-flex align-items-center gap-2 mb-3">
							<span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
							<span class="app-brand-text fw-semibold demo">@TempData.Peek("appName")</span>
						</div>
						<p class="mb-1">@Localizer["CompanyAddressLine1"]</p>
						<p class="mb-1">@Localizer["CompanyAddressLine2"]</p>
						<p class="mb-0">@Localizer["CompanyPhone"]</p>
					</div>

					<div class="text-end">
						<div class="h3 mb-2">@Localizer["Invoice"] #@Model.InvoiceNumber</div>
						<div class="text-secondary small">
							<div class="mb-1"><span class="me-2">@Localizer["Date Issues:"]</span><span class="fw-semibold text-body">@Model.IssueDate.ToShortDateString()</span></div>
							<div><span class="me-2">@Localizer["Date Paid"]:</span><span class="fw-semibold text-body">@Model.PaymentDate?.ToShortDateString()</span></div>
						</div>
					</div>
				</div>

				<hr class="my-4" />

				<div class="row g-4 mb-4">
					<div class="col-12 col-md-7">
						<div class="text-uppercase text-secondary fw-semibold small mb-2">@Localizer["Invoice To:"]</div>
						<div class="fw-semibold">@Model.CompanyName</div>
						<div class="text-secondary">@Localizer["VAT:"] @Model.TaxIdentificationNumber</div>
						<div class="text-secondary">@Model.BillingAddressLine1, @Model.BillingAddressLine2, @Model.BillingCity</div>
						<div class="text-secondary">@Model.BillingPostalCode @Model.BillingState, @Model.BillingCountry</div>
						<div class="text-secondary">@Model.ContactPhone - @Model.ContactEmail</div>
					</div>

					<div class="col-12 col-md-5">
						<div class="text-uppercase text-secondary fw-semibold small mb-2">@Localizer["Bill To:"]</div>
						<div class="card bg-secondary-lt border-0">
							<div class="card-body p-3">
								<div class="d-flex justify-content-between mb-2">
									<div class="text-secondary">@Localizer["Total Due:"]</div>
									<div class="fw-semibold">&euro; @Model.TotalAmount</div>
								</div>
								<div class="d-flex justify-content-between">
									<div class="text-secondary">@Localizer["Payment Method"]</div>
									<div class="fw-semibold">@Model.PaymentMethod</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="table-responsive">
					<table class="table table-vcenter card-table table-striped">
						<thead>
							<tr>
								<th>@Localizer["Description"]</th>
								<th class="text-end">@Localizer["Cost"]</th>
								<th class="text-end">@Localizer["Qty"]</th>
								<th class="text-end">@Localizer["Price"]</th>
							</tr>
						</thead>
						<tbody>
							@{
								if (Model.Items != null)
								{
									foreach (var item in Model.Items)
									{
										<tr>
											<td class="text-heading">@item.Description</td>
											<td class="text-end">&euro;@item.UnitPrice</td>
											<td class="text-end">@item.Quantity</td>
											<td class="text-end fw-semibold">&euro;@item.Subtotal</td>
										</tr>
									}
								}
							}
						</tbody>
					</table>
				</div>

				<div class="row g-4 mt-4">
					<div class="col-12 col-md-7">
						<div class="text-secondary">
							<span class="fw-semibold text-body">@Localizer["Salesperson:"]</span>
							<span class="ms-2">@Localizer["SalespersonNamePlaceholder"]</span>
						</div>
					</div>

					<div class="col-12 col-md-5 ms-auto">
						<div class="card bg-secondary-lt border-0">
							<div class="card-body p-3">
								<div class="d-flex justify-content-between mb-2">
									<div class="text-secondary">@Localizer["Subtotal:"]</div>
									<div class="fw-semibold">&euro;@(Model.TotalAmount - Model.TotalTaxes)</div>
								</div>
								<div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
									<div class="text-secondary">@Localizer["Tax:"]</div>
									<div class="fw-semibold">&euro;@Model.TotalTaxes</div>
								</div>
								<div class="d-flex justify-content-between">
									<div class="text-secondary">@Localizer["Total:"]</div>
									<div class="h3 mb-0">&euro;@Model.TotalAmount</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				@if (!string.IsNullOrWhiteSpace(Model.Notes))
				{
					<hr class="my-4" />
					<div>
						<span class="fw-semibold">@Localizer["Note:"]</span>
						<span class="text-secondary ms-2">@Model.Notes</span>
					</div>
				}

			</div>
		</div>
	</div>

	@* Actions *@
	<div class="col-12 col-lg-3">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title mb-0">@Localizer["Invoice"]</h3>
			</div>
			<div class="card-body">
				<div class="d-grid gap-2">
					<button class="btn btn-primary" type="button">
						<i class="ri-download-2-line me-2"></i>@Localizer["DownloadButton"]
					</button>
					<a class="btn btn-outline-secondary" target="_blank" href="~/Company/Invoices/View/@Model.InvoiceID/Print">
						<i class="ri-printer-line me-2"></i>@Localizer["PrintButton"]
					</a>
				</div>
			</div>
		</div>
	</div>
</div>
