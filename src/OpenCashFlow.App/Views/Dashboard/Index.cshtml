@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard - Analytics";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
    <link rel="stylesheet" href="~/vendor/libs/swiper/swiper.css">
}

@section VendorScripts {
    <script src="~/vendor/libs/apex-charts/apexcharts.js"></script>
    <script src="~/vendor/libs/swiper/swiper.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/cards-statistics.css" />
    <link rel="stylesheet" href="~/vendor/css/pages/cards-analytics.css" />
}

@section PageScripts {
    <script src="~/js/dashboards-analytics.js"></script>
}
@* ************** Content ************** *@

@* Page header *@
<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Dashboard</h2>
            <div class="text-secondary mt-1">@Localizer["OverviewAndRecentActivity"]</div>
        </div>
    </div>
</div>

<div class="row row-cards">

    @await Html.PartialAsync("Components/Gamification_Card")

    @if (User.Claims.Any(c => c.Type == ClaimTypes.Role && c.Value == "CompanyAdmin"))
    {
        @await Html.PartialAsync("Components/Daily_Payments_Total")
        @await Html.PartialAsync("Components/Montly_Payments_Total")
    }

    @await Html.PartialAsync("Components/Activity_Timeline")

    @*
    @await Html.PartialAsync("Components/Payment_Performance")
    *@

</div>
